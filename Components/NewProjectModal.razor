@using ExakisNeliteTSP.Models
@using ExakisNeliteTSP.Services.Interface
@inject IProjectService Projects

@if (Visible)
{
    <div class="modal-overlay" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-container">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Nouveau Projet</h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Fermer"></button>
                </div>

                <EditForm Model="@model" OnValidSubmit="Create">
                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">Titre du projet *</label>
                            <InputText class="form-control" @bind-Value="model.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Client *</label>
                            <InputText class="form-control" @bind-Value="model.Client" />
                        </div>
                        <!-- Statut & Complexité -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Complexité *</label>
                                <InputSelect class="form-select" @bind-Value="model.Complexity">
                                    @foreach (var c in Enum.GetValues<Complexity>())
                                    {
                                        <option value="@c">@Label(c)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Statut *</label>
                                <InputSelect class="form-select"
                                             @bind-Value="model.Status"
                                             @onchange="OnStatusChanged">
                                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                                    {
                                        <option value="@s">@Label(s)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        @* PHASE — visible uniquement si Statut = En cours *@
                        @if (model.Status == ProjectStatus.InProgress)
                        {
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label">Phase (En cours)</label>
                                    <InputSelect class="form-select"
                                                 TValue="ProjectPhase?"
                                                 @bind-Value="model.Phase">
                                        <!-- valeur vide => null -->
                                        <option value="">—</option>
                                        @foreach (var ph in Enum.GetValues<ProjectPhase>())
                                        {
                                            if (ph == ProjectPhase.None) { continue; }
                                            <option value="@ph">@Label(ph)</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        }

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">Chef de projet *</label>
                                <InputText class="form-control" @bind-Value="model.ProjectLead" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date de début *</label>
                                <InputDate class="form-control" @bind-Value="model.StartDate" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date de fin prévue *</label>
                                <InputDate class="form-control" @bind-Value="model.DueDate" />
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" @onclick="Close">Annuler</button>
                        <button class="btn btn-primary" type="submit">Créer le projet</button>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; } // pour @bind-Visible
    [Parameter] public EventCallback OnCreated { get; set; }

    private Project model = new();

    private async Task Create()
    {
        // Validation minimale côté code (utile si tu n’as pas encore de DataAnnotations)
        if (string.IsNullOrWhiteSpace(model.Title) ||
            string.IsNullOrWhiteSpace(model.Client) ||
            string.IsNullOrWhiteSpace(model.ProjectLead) ||
            model.StartDate is null ||
            model.DueDate is null)
        {
            return;
        }

        await Projects.CreateAsync(model);
        await OnCreated.InvokeAsync();       // rafraîchir la liste parent
        model = new();                       // reset formulaire

        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false); // fermer la modale
    }
    private void OnStatusChanged(ChangeEventArgs _)
    {
        if (model.Status != ProjectStatus.InProgress)
            model.Phase = null;   // si on quitte "En cours", on efface la phase
    }


    private async Task Close()
    {
        if (VisibleChanged.HasDelegate)
            await VisibleChanged.InvokeAsync(false);
    }
    private ProjectStatus Status
    {
        get => model.Status;
        set
        {
            model.Status = value;
            if (value != ProjectStatus.InProgress)
                model.Phase = null; // on efface la phase si non pertinente
        }
    }

    private bool showModal = false;  // contrôle l'affichage réel
    private string modalClass = "fade-in"; // fade-in par défaut

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !showModal)
        {
            // ouverture
            showModal = true;
            modalClass = "fade-in show";
        }
        else if (!Visible && showModal)
        {
            // fermeture avec fade-out
            modalClass = "fade-out hide";
            // attendre la fin de l'animation avant de retirer le modal
            await Task.Delay(300);
            showModal = false;
        }
    }


    // Libellés FR
    private static string Label(ProjectStatus s) => s switch
    {
        ProjectStatus.Draft => "Brouillon",
        ProjectStatus.InReview => "En attente de retour",
        ProjectStatus.ValidationPending => "En attente de validation",
        ProjectStatus.InProgress => "En cours",
        ProjectStatus.Done => "Terminé",
        ProjectStatus.OnHold => "En pause",
        _ => s.ToString()
    };

    private static string Label(Complexity c) => c switch
    {
        Complexity.Simple => "Simple",
        Complexity.Medium => "Moyenne",
        Complexity.Complex => "Complexe",
        _ => c.ToString()
    };
    private static string Label(ProjectPhase ph) => ph switch
    {
        ProjectPhase.None => "—",
        ProjectPhase.Pilotage => "Pilotage",
        ProjectPhase.Conception => "Conception",
        ProjectPhase.Construction => "Construction",
        ProjectPhase.Validation => "Validation",
        ProjectPhase.Finalisation => "Finalisation",
        ProjectPhase.Garantie => "Garantie",
        ProjectPhase.TMA => "TMA",
        ProjectPhase.Provision => "Provision",
        _ => ph.ToString()
    };

}
