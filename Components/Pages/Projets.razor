@page "/projets"
@using ExakisNeliteTSP.Models
@using ExakisNeliteTSP.Services.Interface
@inject IProjectService Projects
@using Microsoft.AspNetCore.Components

<h3 class="mb-3">Tous les projets</h3>

@if (loading)
{
    <div class="text-muted">Chargement…</div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="text-muted mb-2">@filtered.Count projet(s)</div>

    @* <!-- Filtre par phase --> *@
    <div class="d-flex align-items-center mb-3">
        <label class="me-2 fw-semibold">Filtrer par statut :</label>
        <select class="form-select w-auto" @bind="selectedPhase">
            <option value="">Tous</option>
            <optgroup label="En cours">
                @foreach (var ph in InProgressPhases)
                {
                    <option value="@ph">@Label(ph)</option>
                }
            </optgroup>

            <optgroup label="Terminés">
                @foreach (var ph in CompletedPhases)
                {
                    <option value="@ph">@Label(ph)</option>
                }
            </optgroup>
            <optgroup label="Brouillons">
                @foreach (var ph in DraftPhases)
                {
                    <option value="@ph">@Label(ph)</option>
                }
            </optgroup>
        </select>
    </div>

    @* <!-- Tableau filtré --> *@
    <table class="table">
        <thead>
            <tr>
                <th>Projet</th>
                <th>Statut</th>
                <th>Chef de projet</th>
                <th>Complexité</th>
                <th>Début</th>
                <th>Fin prévue</th>
                <th>Dernière MAJ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in filtered)
            {
                <tr>
                    <td>
                        <strong>@p.Title</strong>
                        <div class="text-muted small">@p.Client</div>
                    </td>
                    <td>@StatusWithPhase(p.Status, p.Phase)</td>
                    <td>@p.ProjectLead</td>
                    <td>@Label(p.Complexity)</td>
                    <td>@(p.StartDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@(p.DueDate?.ToString("dd/MM/yyyy"))</td>
                    <td>@p.LastUpdated.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="@($"/TSProjet/{p.Id}")">Ouvrir ↗</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    // --- Catégories de phases ---
    private static readonly ProjectPhase[] InProgressPhases = new[]
    {
        ProjectPhase.Pilotage,
        ProjectPhase.Conception,
        ProjectPhase.Construction,
        ProjectPhase.Validation,
        ProjectPhase.Finalisation
    };

    private static readonly ProjectPhase[] CompletedPhases = new[]
    {
        ProjectPhase.Garantie,
        ProjectPhase.TMA,
        ProjectPhase.Provision
    };

    private static readonly ProjectPhase[] DraftPhases = new[]
    {
        ProjectPhase.None
    };

    private List<Project> all = new();
    private List<Project> filtered = new();
    private bool loading = true;
    private string? error;

    private string? selectedPhaseOrStatus;
    private string? _selectedPhase = "";
    private string? selectedPhase
    {
        get => _selectedPhase;
        set
        {
            if (_selectedPhase != value)
            {
                _selectedPhase = value;
                ApplyFilter();
                StateHasChanged();
            }
        }
    }


    // Méthode de filtrage
    private void ApplyFilter()
    {
        IEnumerable<Project> query = all;

        // Filtre par statut (depuis les KPI Cards)
        if (!string.IsNullOrEmpty(StatusFilter))
        {
            if (Enum.TryParse<ProjectStatus>(StatusFilter, out var status))
            {
                query = query.Where(p => p.Status == status);
            }
        }

        // Filtre par PHASE (dropdown dans la page)
        if (!string.IsNullOrEmpty(selectedPhase))
        {
            if (Enum.TryParse<ProjectPhase>(selectedPhase, out var phase))
            {
                query = query.Where(p => p.Phase.HasValue && p.Phase.Value == phase);
            }
        }

        // Filtre par RECHERCHE (barre de recherche)
        if (!string.IsNullOrEmpty(SearchFilter))
        {
            var lower = SearchFilter.ToLower();
            query = query.Where(p =>
                (!string.IsNullOrEmpty(p.Title) &&
                 p.Title.ToLower().Contains(lower)) ||
                (!string.IsNullOrEmpty(p.Client) &&
                 p.Client.ToLower().Contains(lower)) ||
                (!string.IsNullOrEmpty(p.ProjectLead) &&
                 p.ProjectLead.ToLower().Contains(lower))
            );
        }

        // Appliquer tous les filtres et mettre à jour la liste
        filtered = query.ToList();
    }

    // Labels
    private static string Label(ProjectStatus s) => s switch
    {
        ProjectStatus.Draft => "Brouillon",
        ProjectStatus.InReview => "En attente de retour",
        ProjectStatus.ValidationPending => "En attente de validation",
        ProjectStatus.InProgress => "En cours",
        ProjectStatus.Done => "Terminé",
        ProjectStatus.OnHold => "En pause",
        _ => s.ToString()
    };

    private static string Label(Complexity c) => c switch
    {
        Complexity.Simple => "Simple",
        Complexity.Medium => "Moyenne",
        Complexity.Complex => "Complexe",
        _ => c.ToString()
    };

    private static string Label(ProjectPhase ph) => ph switch
    {
        ProjectPhase.None => "",
        ProjectPhase.Pilotage => "Pilotage",
        ProjectPhase.Conception => "Conception",
        ProjectPhase.Construction => "Construction",
        ProjectPhase.Validation => "Validation",
        ProjectPhase.Finalisation => "Finalisation",
        ProjectPhase.Garantie => "Garantie",
        ProjectPhase.TMA => "TMA",
        ProjectPhase.Provision => "Provision",
        _ => ph.ToString()
    };

    private RenderFragment StatusWithPhase(ProjectStatus s, ProjectPhase? ph) => builder =>
    {
        int seq = 0;
        // === Badge Phase ===
        if (ph is ProjectPhase p && p != ProjectPhase.None)
        {
            var phaseClass = p switch
            {
                ProjectPhase.Pilotage => "badge phase-pilotage",
                ProjectPhase.Conception => "badge phase-conception",
                ProjectPhase.Construction => "badge phase-construction",
                ProjectPhase.Validation => "badge phase-validation",
                ProjectPhase.Finalisation => "badge phase-finalisation",
                ProjectPhase.Garantie => "badge phase-garantie",
                ProjectPhase.TMA => "badge phase-tma",
                ProjectPhase.Provision => "badge phase-provision",
                _ => "badge bg-secondary"
            };

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", phaseClass);
            builder.AddContent(seq++, Label(p));
            builder.CloseElement();
        }
        else
        {
            var cls = s switch
            {

                ProjectStatus.InReview => "badge bg-warning text-dark",
                ProjectStatus.ValidationPending => "badge bg-info",
                ProjectStatus.Done => "badge bg-success",
                ProjectStatus.OnHold => "badge bg-secondary",
                ProjectStatus.Draft => "badge bg-light text-dark",
                ProjectStatus.InProgress => "badge bg-primary",
                _ => "badge bg-light text-dark"
            };

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", cls);
            builder.AddContent(seq++, Label(s));
            builder.CloseElement();
        }
    };

    [Parameter]
    [SupplyParameterFromQuery(Name = "phase")]
    public string? PhaseFilter { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchFilter { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusFilter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var items = await Projects.GetAllAsync();
            all = items.OrderByDescending(p => p.LastUpdated).ToList();

            if (!string.IsNullOrEmpty(PhaseFilter))
            {
                selectedPhase = PhaseFilter;
            }

            if (!string.IsNullOrEmpty(SearchFilter))
            {
                Console.WriteLine($"Recherche: {SearchFilter}");
            }

            ApplyFilter(); // filtre initial
        }
        catch (Exception ex)
        {
            error = "Impossible de charger les projets : " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
