@page "/"
@inject IProjectService Projects
@using ExakisNeliteTSP.Models
@using ExakisNeliteTSP.Services.Interface
@inject IConsultantDirectoryService Directory
@using ExakisNeliteTSP.Components
@inject IAbsenceService Absences



<h3 class="mb-1">Dashboard</h3>
<div class="text-muted mb-3">Vue d’ensemble des projets et activités</div>

<div class="row g-3 mb-3">
  <KpiCard Title="Projets en cours"         Value="@inProgress" />
    <KpiCard Title="En attente de signature" Value="@ValidationPending" />
    <KpiCard Title="Consultants actifs" Value="@activeConsultants" />
  

  <KpiCard Title="Consultants en inter-contrat" Value="@benchConsultants" />
    <KpiCard Title="Projets terminés" Value="@done" />
    <KpiCard Title="En attente de validation" Value="@inReview" />

    <KpiCard Title="Projets en brouillon" Value="@draft" />

  <KpiCard Title="Consultants absents" Value="@absentConsultants" />


</div>

<div class="d-flex align-items-center justify-content-between mt-3">
    <h5 class="mb-0">Projets récents</h5>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="/projets">Voir tous les projets</a>
        <button class="btn btn-primary" @onclick="() => showNew = true">+ Nouveau projet</button>
    </div>
</div>


<table class="table mt-2">
    <thead>
        <tr>
            <th>Projet</th>
            <th>Statut</th>
            <th>Chef de projet</th>
            <th>Complexité</th>
            <th>Début</th>
            <th>Fin prévue</th>
            <th>Dernière MAJ</th>
            <th></th>
        </tr>
    </thead>

  <tbody>
    @foreach (var p in filtered)
    {
            <tr>
                <td>
                    <strong>@p.Title</strong>
                    <div class="text-muted small">@p.Client</div>
                </td>
                <td>@StatusWithPhase(p.Status, p.Phase)</td>
                <td>@p.ProjectLead</td>
                <td>@Label(p.Complexity)</td>
                <td>@(p.StartDate?.ToString("dd/MM/yyyy"))</td>
                <td>@(p.DueDate?.ToString("dd/MM/yyyy"))</td>
                <td>@p.LastUpdated.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td><a class="btn btn-sm btn-outline-primary" href="@($"/TSProjet/{p.Id}")">Ouvrir ↗</a></td>
            </tr>

    }
  </tbody>
</table>

<NewProjectModal @bind-Visible="showNew"
                 OnCreated="Refresh" />

@code {
    private int benchConsultants;
    private int ValidationPending;
    private int absentConsultants;
    private int draft; 



  private List<Project> projects = new();
  private List<Project> filtered = new();
  private int inProgress, inReview, done, activeConsultants;
  private bool showNew;
  private string? search;
  private string? statusFilter;

  protected override async Task OnInitializedAsync() => await Refresh();

  private async Task Refresh()
  {
    projects = await Projects.GetAllAsync();
    inProgress = await Projects.CountByStatusAsync(ProjectStatus.InProgress);
    inReview   = await Projects.CountByStatusAsync(ProjectStatus.InReview);
    done       = await Projects.CountByStatusAsync(ProjectStatus.Done);
    activeConsultants = await Projects.CountActiveConsultantsAsync();
    draft = await Projects.CountByStatusAsync(ProjectStatus.Draft);
    ValidationPending = await Projects.CountByStatusAsync(ProjectStatus.ValidationPending);


    ApplyFilters();
        var totalConsultants = await Directory.GetAllConsultantsAsync();
        var total = totalConsultants.Count;
        benchConsultants = Math.Max(0, total - activeConsultants - absentConsultants);

        try
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow); // ou DateTime.Now si tu préfères
            var abs = await Absences.GetAbsentConsultantsAsync(today);
            absentConsultants = abs
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => n.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Count();
        }
        catch
        {
            absentConsultants = 0; // en cas d'erreur, on n’empêche pas l’UI de s’afficher
        }


  }
    private static string Label(Complexity c) => c switch
    {
        Complexity.Simple => "Simple",
        Complexity.Medium => "Moyenne",
        Complexity.Complex => "Complexe",
        _ => c.ToString()
    };

    private const int HomeTopCount = 8; // configurable

    private void ApplyFilters()
    {
        filtered = projects
            .OrderByDescending(p => p.LastUpdated)
            .Take(HomeTopCount)
            .ToList();
        // StateHasChanged(); // inutile ici
    }

 

  private void ClearFilters()
  {
    search = statusFilter = null;
    ApplyFilters();
  }

  // Libellés FR d'affichage des statuts (sans toucher aux noms techniques de l'énum)
  private static string Label(ProjectStatus s) => s switch
  {
    ProjectStatus.Draft => "Brouillon",
    ProjectStatus.InProgress => "En cours",
    ProjectStatus.InReview   => "En attente de validation",
    ProjectStatus.Done       => "Terminé",
    ProjectStatus.ValidationPending   => "En attente de singature",
    ProjectStatus.OnHold     => "En pause",
    _                        => s.ToString()
  };

  private RenderFragment Badge(ProjectStatus s) => builder =>
  {
    var cls = s switch {
      ProjectStatus.InProgress => "badge bg-primary",
      ProjectStatus.InReview   => "badge bg-warning text-dark",
      ProjectStatus.Done       => "badge bg-success",
      ProjectStatus.ValidationPending   => "badge bg-info",
      ProjectStatus.OnHold     => "badge bg-secondary",
      _                        => "badge bg-light text-dark"
    };
    builder.OpenElement(0, "span");
    builder.AddAttribute(1, "class", cls);
    builder.AddContent(2, Label(s)); // affiche le libellé FR
    builder.CloseElement();
  };
    private static string Label(ProjectPhase ph) => ph switch
    {
        ProjectPhase.None => "—",
        ProjectPhase.Pilotage => "Pilotage",
        ProjectPhase.Conception => "Conception",
        ProjectPhase.Construction => "Construction",
        ProjectPhase.Validation => "Validation",
        ProjectPhase.Finalisation => "Finalisation",
        ProjectPhase.Garantie => "Garantie",
        ProjectPhase.TMA => "TMA",
        ProjectPhase.Provision => "Provision",
        _ => ph.ToString()
    };
    private RenderFragment StatusWithPhase(ProjectStatus s, ProjectPhase? ph) => builder =>
{
    // badge statut (comme avant)
    var cls = s switch
    {
        ProjectStatus.InProgress => "badge bg-primary",
        ProjectStatus.InReview => "badge bg-warning text-dark",
        ProjectStatus.ValidationPending => "badge bg-info",
        ProjectStatus.Done => "badge bg-success",
        ProjectStatus.OnHold => "badge bg-secondary",
        _ => "badge bg-light text-dark"
    };
    builder.OpenElement(0, "span");
    builder.AddAttribute(1, "class", cls);
    builder.AddContent(2, Label(s));
    builder.CloseElement();

    // si "En cours" + phase, on ajoute un 2e badge bleu, à droite
    if (s == ProjectStatus.InProgress && ph is ProjectPhase p && p != ProjectPhase.None)
    {
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "badge bg-primary ms-1"); // même bleu + petit espace
        builder.AddContent(5, Label(p));
        builder.CloseElement();
    }
};


}
