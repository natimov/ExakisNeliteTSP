    private async Task SaveResources()
    {
        if (project is null) return;

        try
        {
            // 1) Recalcul pour être sûr que tout est cohérent
            ProfilComputeService.ComputeAll(project);

            // 2) Sauvegarde des lignes Profil dans la table ProjectProfilRows
            await ProfilRowsSvc.SaveProfilEntriesAsync(project.Id, project.Profils);

            // 3) MAJ de la fiche projet (ex. RemiseTjmPercent, LastUpdated, etc.)
            project.LastUpdated = DateTime.UtcNow;
            await Projects.UpdateAsync(project);

            // (optionnel) recharger depuis la BDD pour être pile-poil aligné
            project.Profils = await ProfilRowsSvc.LoadProfilEntriesAsync(project.Id);
            ProfilComputeService.ComputeAll(project);
        }
        catch (Exception ex)
        {
            error = "Erreur lors de l'enregistrement : " + ex.Message;
        }
    }
