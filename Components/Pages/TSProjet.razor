        planningDirty = true;
    }

    private List<WorkloadItem> wlRows = new();


    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null; project = null;
        try
        {
            project = await Projects.GetByIdAsync(id);
            if (project is null)
            {
                error = "Projet introuvable.";
            }
            else
            {
                // 1) Profils depuis la base
                project.Profils = await ProfilRowsSvc.LoadProfilEntriesAsync(project.Id);
                foreach (var r in project.Profils)
                {
                    r.Months ??= new decimal?[12];
                    if (r.PlanningYear == 0) r.PlanningYear = DateTime.UtcNow.Year;
                }

                // 2) Phases (UI only) au premier passage
                if (phasePlans.Count == 0)
                {
                    foreach (var ph in Enum.GetValues<ProjectPhase>())
                    {
                        if (ph == ProjectPhase.None) continue;
                        phasePlans.Add(new PhasePlan { Phase = ph, Year = DateTime.UtcNow.Year });
                    }
                }

                // 3) Année visible par défaut
                currentYear = project.Profils.FirstOrDefault()?.PlanningYear ?? DateTime.UtcNow.Year;

                // 4) Charger référentiels + jalons (avant de calculer l’horizon FAE)
                await LoadTjmAsync();
                await LoadAchatsAsync();
                await LoadPrestasAsync();
                await LoadFraisAsync();
                EnsureEcheancierMonthOptions();
                await EchLoadAsync();
                wlRows = await WorkloadService.LoadAsync(project.Id);
                if (wlRows.Count == 0)
                {
                    var created = await WorkloadService.CreateParentAsync(project.Id, 1);
                    wlRows.Add(created);
                    wlSelected = created;
                }



                // === Définir un horizon ROBUSTE couvrant passé et futur ===
                const int PAST_BUFFER_YEARS = 3;   // charge aussi 3 ans en arrière
                const int FUTURE_BUFFER_YEARS = 3; // et 3 ans en avant

                int planningYear = project!.Profils!.FirstOrDefault()?.PlanningYear ?? DateTime.UtcNow.Year;

                // dernier jalon connu (si aucun, on restera sur planningYear)
                var startFAE = new DateTime(planningYear, 1, 1);
                var lastMilestoneFAE = (echeanciers ?? new())
                    .Where(e => e.BillingYear > 0 && e.BillingMonth is >= 1 and <= 12)
                    .Select(e => new DateTime(e.BillingYear, e.BillingMonth, 1))
                    .DefaultIfEmpty(startFAE)
                    .Max();

                // bornes d’horizon : au minimum (min(planningYear,currentYear)-buffer) … (max(jalon,currentYear)+buffer)
                int beginYear = Math.Min(planningYear, currentYear) - PAST_BUFFER_YEARS;
                int endYear = Math.Max(lastMilestoneFAE.Year, currentYear) + FUTURE_BUFFER_YEARS;

                // sécurité
                beginYear = Math.Max(2000, beginYear);
                endYear = Math.Min(2100, endYear);

                // === CHARGEMENT MULTI-ANNÉES DEPUIS LA BDD UNIQUEMENT ===
                _jhAllYears.Clear();

                for (int year = beginYear; year <= endYear; year++)
                {
                    // BDD : (profilDbId, mois) -> decimal? JH
                    var monthDictYear = await ProfileMonthlySvc.LoadAsync(project.Id, year);

                    foreach (var r in project.Profils)
                    {
                        if (r.DbRowId is not int pid) continue;

                        for (int m = 1; m <= 12; m++)
                        {
                            decimal jh = 0m;

                            // 1) clé 1..12
                            if (monthDictYear.TryGetValue((pid, m), out var v1) && v1.HasValue)
                                jh = v1.Value;
                            // 2) clé 0..11 (ancien schéma possible)
                            else if (monthDictYear.TryGetValue((pid, m - 1), out var v0) && v0.HasValue)
                                jh = v0.Value;

                            // ❗ Aucun fallback UI ici
                            _jhAllYears[(pid, year, m)] = jh;
                        }
                    }
                }

                // (optionnel) petit log de contrôle
                // var totalAll = _jhAllYears.Values.Sum();
                // Console.WriteLine($"[DEBUG] Total JH toutes années = {totalAll}");


                // === FIN CHARGEMENT JH MULTI-ANNEES ===

                // 6) Maintenant qu’on a _jhAllYears, on hydrate l’UI de l’année visible
                await LoadPlanningYearAsync(currentYear);

                // 7) Recalculs d’affichage
                ProfilComputeService.ComputeAll(project);
                var map = FaeBuildCoutEngageCumul();

                // (Logs de debug optionnels)
                // Console.WriteLine($"[FAE] Server: keys={map.Count}");
            }
        }
        catch (Exception ex)
        {
            error = "Erreur lors du chargement : " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }


    // TSProjet.razor (section @code)
private int currentYear;           // année visible dans le tableau
private bool planningDirty = false; // si des cases ont été modifiées
    private async Task LoadPlanningYearAsync(int year)
    {
        currentYear = year;

        if (project?.Profils is null) return;

        foreach (var r in project.Profils)
        {
            r.Months ??= new decimal?[12];

            var pid = r.DbRowId ?? 0;
            for (int m = 1; m <= 12; m++)
            {
                if (pid > 0 && _jhAllYears.TryGetValue((pid, year, m), out var jh))
                    r.Months[m - 1] = jh;
                else
                    r.Months[m - 1] = 0m; // Vue de l'année : on ne touche pas aux autres années
            }
        }

        StateHasChanged();
    }

    // Somme des JH pour une année donnée (utile si tu as besoin d’afficher le total de l’année visible)
    private decimal GetPlannedForYear(ProfilEntry r, int year)
    {
        if (r.DbRowId is not int pid) return 0m;

        decimal sum = 0m;
        for (int m = 1; m <= 12; m++)
            if (_jhAllYears.TryGetValue((pid, year, m), out var v))
                sum += v;
        return sum;
    }

    // Somme des JH sur TOUTES les années (clé du problème)
    private decimal GetPlannedAllYears(ProfilEntry r)
    {
        if (r.DbRowId is not int pid) return 0m;

        decimal sum = 0m;
        foreach (var kv in _jhAllYears)
            if (kv.Key.profilId == pid)
                sum += kv.Value;
        return sum;
    }

    // Reste à répartir (toutes années)
    private decimal GetRemainingAllYears(ProfilEntry r)
    {
        var total = r.ChargeJh ?? 0m;
        var planned = GetPlannedAllYears(r);
        var rest = total - planned;
        return rest < 0 ? 0 : rest;   // si tu veux brider à 0
    }

