                                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                                    {
                                        <option value="@s">@Label(s)</option>
                                    }
                                </InputSelect>
                            </div>
                            @if (project.Status == ProjectStatus.InProgress)
                            {
                                <div class="col-md-3">
                                    <label class="form-label">Phase (En cours)</label>
                                    <InputSelect class="form-select"
                                                 TValue="ProjectPhase?"
                                                 @bind-Value="project.Phase">
                                        <option value="">—</option>
                                        @foreach (var ph in Enum.GetValues<ProjectPhase>())
                                        {
                                            if (ph == ProjectPhase.None) { continue; }
                                            <option value="@ph">@Label(ph)</option>
                                        }
                                    </InputSelect>
                                </div>
                            }
                            <div class="col-md-3">
                                <label class="form-label">Complexité</label>
                                <InputSelect class="form-select" @bind-Value="project.Complexity">
                                    @foreach (var c in Enum.GetValues<Complexity>())
                                    {
                                        <option value="@c">@Label(c)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label">Référence propale</label>
                                    <InputText class="form-control" @bind-Value="project.ProposalRef" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Contact client</label>
                                    <InputText class="form-control" @bind-Value="project.ClientContact" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Agence</label>
                                    <InputText class="form-control" @bind-Value="project.Agency" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Service line</label>
                                    <InputText class="form-control" @bind-Value="project.ServiceLine" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Directeur d’agence</label>
                                    <InputText class="form-control" @bind-Value="project.AgencyDirector" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Responsable SL</label>
                                    <InputText class="form-control" @bind-Value="project.ServiceLineManager" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Commercial</label>
                                    <InputText class="form-control" @bind-Value="project.SalesRep" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Chef de projet back (Unit4)</label>
                                    <InputText class="form-control" @bind-Value="project.BackProjectManager" />
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-3">
                                    <label class="form-label">Type de contrat</label>
                                    <InputText class="form-control" @bind-Value="project.ContractType" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Montant du contrat</label>
                                    <InputNumber class="form-control" @bind-Value="project.ContractAmount" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">dont CA back</label>
                                    <InputNumber class="form-control" @bind-Value="project.ContractCaBack" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Montant du contrat back</label>
                                    <InputNumber class="form-control" @bind-Value="project.ContractBackAmount" />
                                </div>
                            </div>


                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Enregistrer</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CancelOverview">Annuler</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    }

    @* --- Onglet 2 : Synthèse & Métriques --- *@
    else if (activeTab == "summary")
    {
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Statut</div>
                        <div class="fs-5">@StatusWithPhase(project.Status, project.Phase)</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Complexité</div>
                        <div class="fs-5">@Label(project.Complexity)</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Début</div>
                        <div class="fs-5">@(project.StartDate?.ToString("dd/MM/yyyy"))</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Fin prévue</div>
                        <div class="fs-5">@(project.DueDate?.ToString("dd/MM/yyyy"))</div>
                    </div>
                </div>
            </div>

            <!-- Placeholder de métriques (à alimenter plus tard) -->
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header">Métriques clés</div>
                    <div class="card-body text-muted">
                        KPI, risques, commentaires — à venir.
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- Onglet 3 : Ressources & Charges --- *@

    else if (activeTab == "resources")
    {
        <ProjectResources Rows="project?.Profils"
                          RemiseTjmPercent="project?.RemiseTjmPercent"
                          ProjectTjms="projectTjms"
                          OnAddRow="AddProfilRow"
                          OnSave="SaveResources"
                          OnRemoveRow="RemoveProfilRow"
                          OnRecompute="RecomputeAll"
                          OnRemiseChanged="@( (decimal? v) => { project!.RemiseTjmPercent = v; RecomputeAll(); } )"
                          Money="Money"
                          Num="Num"
                          Pct="Pct"
                          RenderRefTableSimple="RenderRefTableSimple" />
    }

    @* --- Onglet : X --- *@
    else if (activeTab == "x")
{
        @* ======== WORKLOAD (HTML/Razor prêt à coller) ======== *@

        <div class="fw-semibold mb-2">Workload</div>



        <div class="d-flex align-items-center gap-2 mb-2">
            <button class="btn btn-primary btn-sm"
                    disabled="@saving"
                    @onclick="SaveWorkloadAsync">
                @(saving ? "Enregistrement..." : "Enregistrer")
            </button>

            @if (lastSavedAt is not null)
            {
                <span class="text-muted small">Dernier enregistrement : @lastSavedAt?.ToString("HH:mm:ss")</span>
            }
            @if (!string.IsNullOrEmpty(saveError))
            {
                <span class="text-danger small">(@saveError)</span>
            }
        </div>

        <div class="table-responsive wl-wrap" @onclick="() => wlMenuOpenFor = null">
            <table class="table table-sm wl-table mb-0">
                @{
                    // Déclaration UNIQUE pour éviter tout conflit
                    var profs = WlGetProfiles();
                    int n = profs.Count;
                }

                <colgroup>
                    <col style="width:2.5rem;">   @* Actions (⋮) *@
                    <col style="width:5.5rem;">   @* ID *@
                    <col style="width:9rem;">     @* Lot *@
                    <col style="width:10rem;">    @* Phase *@
                    <col style="width:12rem;">    @* Étape *@
                    <col style="min-width:36rem;">@* Tâche *@
                    <col style="width:7rem;">     @* Total JH *@
                    <col style="width:11rem;">    @* Total Valorisation *@
                    @for (int i = 0; i < n; i++)
                    {
                        <col style="width:6.5rem;">
                    }
          @* JH par profil *@
                    @for (int i = 0; i < n; i++)
                    {
                        <col style="width:8rem;">
                    }
            @* € par profil *@
                    <col style="width:14rem;">    @* Livrable *@
                    <col style="width:18rem;">    @* Commentaire *@
                </colgroup>

                <thead>
                    @* -------- Ligne 1 : groupes principaux -------- *@
                    <tr class="wl-head-group">
                        <th rowspan="2"></th>  @* Actions *@
                        <th rowspan="2" class="wl-head-structure">ID</th>
                        <th rowspan="2" class="wl-head-structure">Lot</th>
                        <th rowspan="2" class="wl-head-structure">Phase</th>
                        <th rowspan="2" class="wl-head-structure">Étape</th>
                        <th rowspan="2" class="wl-head-structure wl-sep-right">Tâche</th>

                        <th colspan="2" class="text-center wl-head-total wl-sep-right">SOUS TOTAL</th>
                        <th colspan="@n" class="text-center wl-head-profil-jh wl-sep-right">Charge par profil</th>
                        <th colspan="@n" class="text-center wl-head-profil-eu wl-sep-right">Valorisation par profil</th>

                        <th rowspan="2" class="wl-head-comment">Livrable</th>
                        <th rowspan="2" class="wl-head-comment">Hypothèses/Commentaire</th>
                    </tr>

                    @* -------- Ligne 2 : sous-colonnes -------- *@
                    <tr>
                        <th class="text-end wl-head-total">TOTAL Charge</th>
                        <th class="text-end wl-head-total wl-sep-right">TOTAL Valorisation</th>

                        @for (var i = 0; i < profs.Count; i++)
                        {
                            var p = profs[i];
                            var cls = $"text-end wl-head-profil-jh {(i == profs.Count - 1 ? "wl-sep-right" : "")}";
                            <th class="@cls">@p.Name<br /><small>(JH)</small></th>
                        }

                        @for (var i = 0; i < profs.Count; i++)
                        {
                            var p = profs[i];
                            var cls = $"text-end wl-head-profil-eu {(i == profs.Count - 1 ? "wl-sep-right" : "")}";
                            <th class="@cls">@p.Name<br /><small>(€)</small></th>
                        }
                    </tr>

                    @* -------- Ligne 3 : bandeau "SOUS-TOTAL visibles" -------- *@
                    <tr class="wl-subtotalbar">
                        <th></th>  @* Actions *@
                        <th colspan="5" class="text-end text-muted">SOUS-TOTAL visibles :</th>

                        <th class="text-end fw-semibold">@WlGrandTotalJH().ToString("N2")</th>
                        <th class="text-end fw-semibold wl-sep-right">@WlGrandTotalValue(profs).ToString("N2")</th>

                        @for (var i = 0; i < profs.Count; i++)
                        {
                            var p = profs[i];
                            var cls = $"text-end fw-semibold {(i == profs.Count - 1 ? "wl-sep-right" : "")}";
                            <th class="@cls">@WlTotalChargesForProfile(p.ProfileId).ToString("N2")</th>
                        }

                        @for (var i = 0; i < profs.Count; i++)
                        {
                            var p = profs[i];
                            var cls = $"text-end fw-semibold {(i == profs.Count - 1 ? "wl-sep-right" : "")}";
                            <th class="@cls">@WlTotalValuesForProfile(p.ProfileId, p.PricePerDay).ToString("N2")</th>
                        }

                        <th></th>
                        <th></th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var r in WlOrderedRows())
                    {
                        var isParent = r.ParentId is null;
                        var cls = $"{PhaseCss(r.Phase)} {(isParent ? "wl-parent" : "")}";


                        <tr class="@cls" @onclick="@(() => { wlSelected = r; wlMenuOpenFor = null; })">
                            <!-- Actions (menu 100% Blazor) -->
                            <td class="text-center position-relative" @onclick:stopPropagation="true">
                                <button class="btn btn-link btn-sm p-0" title="Actions" @onclick="() => ToggleRowMenu(r)">
                                    &#8942;  @* ⋮ *@
                                </button>

                                @if (wlMenuOpenFor == r.Id)
                                {
                                    <div class="wl-menu">
                                        <button class="dropdown-item" @onclick="() => WlInsertParentBelowAt(r)">+ Grande étape dessous</button>
                                        <button class="dropdown-item" @onclick="() => WlInsertChildBelowAt(r)">+ Sous-étape dessous</button>
                                        <hr class="dropdown-divider" />
                                        <button class="dropdown-item text-danger" @onclick="() => WlDeleteRow(r)">Supprimer la ligne</button>
                                    </div>
                                }
                            </td>

                            <!-- ID -->
                            <td>@WlDisplayId(r)</td>

                            <!-- Lot -->
                            <td>
                                @if (isParent)
                                {
                                    <input class="form-control form-control-sm"
                                           @bind="r.Lot"
                                           @bind:after="() => WlPropagateFromParent(r, lot: true, groupCode: false)" />
                                }
                                else
                                {
                                    <input class="form-control form-control-sm" @bind="r.Lot" />
                                }
                        </td>

                        <!-- Phase / Étape -->
                            <!-- Phase (select enum) -->
                            <td>
                                @if (isParent)
                                {
                                    <div class="text-muted small"></div>
                                }
                                else
                                {
                                    <InputSelect class="form-select form-select-sm" @bind-Value="r.Phase">
                                        @foreach (var ph in Enum.GetValues<ProjectPhase>())
                                        {
                                            if (ph == ProjectPhase.None) continue;
                                            <option value="@Label(ph)">@Label(ph)</option>
                                        }
                                    </InputSelect>
                                }
                            </td>


                            <!-- Étape (select dépendant de la phase) -->
                            <!-- Étape (liste complète, non filtrée) -->
                            <td>
                                @if (isParent)
                                {
                                    <div class="text-muted small"></div>
                                }
                                else
                                {
                                    <InputSelect class="form-select form-select-sm" @bind-Value="r.Etape">
                                        @foreach (var et in Enum.GetValues<ProjectEtape>())
                                        {
                                            if (et == ProjectEtape.None) continue;
                                            <option value="@Label(et)">@Label(et)</option>
                                        }
                                    </InputSelect>
                                }
                            </td>




                        <!-- Tâche -->
                        <td><input class="form-control form-control-sm" @bind="r.Tache" /></td>

                        <!-- TOTAL JH -->
                        <td class="text-end">@WlSumCharges(r, profs).ToString("N2")</td>

                        <!-- TOTAL Valorisation (€) -->
                            <td class="text-end">@((isParent ? wlRows.Where(c => c.ParentId == r.Id).Sum(c => WlSumRowValues(c, profs)) : WlSumRowValues(r, profs)).ToString("N2"))</td>



                            @* CHARGES (JH) par profil *@

                @foreach (var p in profs)
                            {
                                if (isParent)
                                {
                                    <td class="text-end">@WlSumChildrenCharges(r.Id, p.ProfileId).ToString("N2")</td>
                                }
                                else
                                {
                                    // 1) lire le JH du dictionnaire
                                    var has = r.ChargesByProfile.TryGetValue(p.ProfileId, out var jh);
                                    // 2) valeur affichée pour <input type="number"> -> DOIT être avec un point
                                    var s = has ? jh.ToString(CultureInfo.InvariantCulture) : string.Empty;

                                    <td>
                                        <input type="number" step="0.5"
                                               class="form-control form-control-sm text-end"
                                               value="@s"
                                               @onchange="(ChangeEventArgs e) => WlUpdateAlloc(r, p.ProfileId, e.Value?.ToString())" />
                                    </td>
                                }
                            }


                            @* VALORISATION (€) par profil *@
                            @foreach (var p in profs)
                            {
                                if (isParent)
                                {
                                    <td class="text-end">@WlSumChildrenValues(r.Id, p.ProfileId, p.PricePerDay).ToString("N2")</td>
                                }
                                else
                                {
                                    <td class="text-end">@WlValueFor(r, p.ProfileId, p.PricePerDay).ToString("N2")</td>
                                }
                            }

                            <!-- Livrable / Commentaire -->
                            <td><input class="form-control form-control-sm" @bind="r.Livrable" /></td>
                            <td><input class="form-control form-control-sm" @bind="r.Commentaire" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>




}



    @* --- Onglet 4 : Budget & Finances --- *@
    else if (activeTab == "finance")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Achats — Matériel / Logiciel</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddAchatRow">Ajouter une ligne</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAchatsAsync">Enregistrer</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Désignation</th>
                            <th>Type</th>
                            <th class="num">Coût unitaire (HT)</th>
                            <th class="num">Qté</th>
                            <th class="num">Montant achat (HT)</th>
                            <th class="num">Coût unitaire revente (HT)</th>
                            <th class="num">Montant revente (HT)</th>
                            <th class="num">Markup %</th>
                            <th>Commentaire</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (achatItem.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-3">
                                    Aucun achat — cliquez « Ajouter une ligne ».
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in achatItem)
                            {
                                <tr>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               value="@row.Designation"
                                               @oninput="e => row.Designation = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td>
                                        <InputSelect @bind-Value="row.PurchaseType" class="form-control form-control-sm col_type ">
                                        @foreach (var type in Enum.GetValues<PurchaseType>())
                                        {
                                            <option value="@type">@LabelPurchaseType(type)</option>
                                        }
                                        </InputSelect>
                                    </td>
                                    <td>
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="row.UnitCostHt" />
                                    </td>
                                    <td>
                                    <InputNumber TValue="decimal?" class="form-control form-control-sm text-end col_quanti"
                                                     @bind-Value="row.Quantity" />
                                    </td>
                                    <td class="text-end">@((row.AmountPurchaseHt ?? (row.UnitCostHt ?? 0m) * (row.Quantity ?? 0m)).ToString("N2"))</td>
                                    <td>
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="row.UnitResaleHt" />
                                    </td>
                                    <td class="text-end">@((row.AmountResaleHt ?? (row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m)).ToString("N2"))</td>
                                    <td class="text-end">
                                        @((row.MarkupPercent ?? (
                                                                ((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m) > 0m
                                                                ? (((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m)) - ((row.UnitCostHt ?? 0m) * (row.Quantity ?? 0m)))
                                                                / ((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m))
                                                                : 0m)
                                                                )).ToString("P2"))
                    </td>

                    <td>
                        <input class="form-control form-control-sm"
                               value="@row.Comment"
                               @oninput="e => row.Comment = e.Value?.ToString() ?? string.Empty" />
                    </td>
                    <td>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteAchatRow(row))">❌</button>
                    </td>
                </tr>
                                }
                        }
                    </tbody>
                    @if (achatItem.Count > 0)
                    {
                        var totalAchat = achatItem.Sum(x => x.AmountPurchaseHt ?? (x.UnitCostHt ?? 0m) * (x.Quantity ?? 0m));
                        var totalRevente = achatItem.Sum(x => x.AmountResaleHt ?? (x.UnitResaleHt ?? 0m) * (x.Quantity ?? 0m));

                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="4" class="text-end">TOTAL</td>
                                <td class="text-end">@totalAchat.ToString("N2")</td>
                                <td></td>
                                <td class="text-end">@totalRevente.ToString("N2")</td>
                                <td class="text-end">@((totalAchat > 0 ? (totalRevente - totalAchat) / totalAchat : 0m).ToString("P2"))</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Achat Prestataires externes</span>
                <div class="d-flex gap-2">
