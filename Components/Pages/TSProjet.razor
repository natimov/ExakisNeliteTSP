            <!-- ====== Agences (exactement comme l’Excel) ====== -->
            @RenderRefTableSimple("Agences : TJM / CJM (référence)", "Agences",
            new[] { "TJM Paris", "CJM Paris", "TJM Région", "CJM Région" })

            <!-- ====== CES Log ====== -->
            @RenderRefTableSimple("CES Log : TJM / CJM / PRCS (référence)", "CES Log",
                    new[] { "TJM CES", "CJM CES", "PRCS CES" })

            <!-- ====== CES Infra ====== -->
            @RenderRefTableSimple("CES Infra : TJM / CJM (référence)", "CES Infra",
                    new[] { "TJM CES", "CJM CES" })
}





    }
    @* --- Onglet : X --- *@
    else if (activeTab == "x")
    {
        <div class="card shadow-sm">
            <div class="card-header">Onglet X</div>
            <div class="card-body text-muted">
                Contenu de l’onglet X — à venir.
            </div>
        </div>
    }


    @* --- Onglet 4 : Budget & Finances --- *@
    else if (activeTab == "finance")
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Achats — Matériel / Logiciel</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddAchatRow">Ajouter une ligne</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAchatsAsync">Enregistrer</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Désignation</th>
                            <th>Type</th>
                            <th class="num">Coût unitaire (HT)</th>
                            <th class="num">Qté</th>
                            <th class="num">Montant achat (HT)</th>
                            <th class="num">Coût unitaire revente (HT)</th>
                            <th class="num">Montant revente (HT)</th>
                            <th class="num">Markup %</th>
                            <th>Commentaire</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (achatItem.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-3">
                                    Aucun achat — cliquez « Ajouter une ligne ».
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in achatItem)
                            {
                                <tr>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               value="@row.Designation"
                                               @oninput="e => row.Designation = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td>
                                        <InputSelect @bind-Value="row.PurchaseType" class="form-control form-control-sm col_type ">
                                        @foreach (var type in Enum.GetValues<PurchaseType>())
                                        {
                                            <option value="@type">@LabelPurchaseType(type)</option>
                                        }
                                        </InputSelect>
                                    </td>
                                    <td>
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="row.UnitCostHt" />
                                    </td>
                                    <td>
                                    <InputNumber TValue="decimal?" class="form-control form-control-sm text-end col_quanti"
                                                     @bind-Value="row.Quantity" />
                                    </td>
                                    <td class="text-end">@((row.AmountPurchaseHt ?? (row.UnitCostHt ?? 0m) * (row.Quantity ?? 0m)).ToString("N2"))</td>
                                    <td>
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="row.UnitResaleHt" />
                                    </td>
                                    <td class="text-end">@((row.AmountResaleHt ?? (row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m)).ToString("N2"))</td>
                                    <td class="text-end">
                                        @((row.MarkupPercent ?? (
                                                                ((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m) > 0m
                                                                ? (((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m)) - ((row.UnitCostHt ?? 0m) * (row.Quantity ?? 0m)))
                                                                / ((row.UnitResaleHt ?? 0m) * (row.Quantity ?? 0m))
                                                                : 0m)
                                                                )).ToString("P2"))
                    </td>

                    <td>
                        <input class="form-control form-control-sm"
                               value="@row.Comment"
                               @oninput="e => row.Comment = e.Value?.ToString() ?? string.Empty" />
                    </td>
                    <td>
                        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteAchatRow(row))">❌</button>
                    </td>
                </tr>
                                }
                        }
                    </tbody>
                    @if (achatItem.Count > 0)
                    {
                        var totalAchat = achatItem.Sum(x => x.AmountPurchaseHt ?? (x.UnitCostHt ?? 0m) * (x.Quantity ?? 0m));
                        var totalRevente = achatItem.Sum(x => x.AmountResaleHt ?? (x.UnitResaleHt ?? 0m) * (x.Quantity ?? 0m));

                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="4" class="text-end">TOTAL</td>
                                <td class="text-end">@totalAchat.ToString("N2")</td>
                                <td></td>
                                <td class="text-end">@totalRevente.ToString("N2")</td>
                                <td class="text-end">@((totalAchat > 0 ? (totalRevente - totalAchat) / totalAchat : 0m).ToString("P2"))</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Achat Prestataires externes</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddPrestaRow">Ajouter une ligne</button>
                    <button class="btn btn-sm btn-primary" @onclick="SavePrestasAsync">Enregistrer</button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        @{
                            // Noms uniques pour éviter les collisions avec d'autres tableaux
                            var prestaRows = prestas ?? new List<AchatPrestataireItem>();

                            decimal sumCoutJour = prestaRows.Sum(r => r.CoutJour ?? 0m);
                            decimal sumNbj = prestaRows.Sum(r => r.NbJours ?? 0m);
                            decimal sumTjm = prestaRows.Sum(r => r.Tjm ?? 0m);

                            decimal totalCoutP = prestaRows.Sum(r => r.TotalCout ?? 0m);
                            decimal totalReventeP = prestaRows.Sum(r => r.MontantRevente ?? 0m);
                            decimal? markupGlobalP = totalReventeP > 0 ? (totalReventeP - totalCoutP) / totalReventeP : (decimal?)null;
                        }

                        <thead class="table-light">
                            <tr>
                                <th class="col-wide">Prestation</th>
                                <th class="col-wide">Société</th>
                                <th class="col-narrow text-end">Coût jour (HT)</th>
                                <th class="col-narrow text-end">Nbj</th>
                                <th class="text-end">Total coût (HT)</th>
                                <th class="col-narrow text-end">TJM (HT)</th>
                                <th class="text-end">Montant revente (HT)</th>
                                <th class="text-end">Markup (%)</th>
                                <th class="col-wide">Commentaire</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (prestaRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-3">Aucune ligne — cliquez « Ajouter une ligne ».</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in prestaRows)
                                {
                                    <tr>
                                        <!-- Prestation -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Prestation" />
                                        </td>

                                        <!-- Société -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Societe" />
                                        </td>

                                        <!-- Coût jour -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.CoutJour" />
                                        </td>

                                        <!-- Nbj -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.NbJours" />
                                        </td>

                                        <!-- Total coût (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end" value="@((r.TotalCout ?? 0m).ToString("N2"))" readonly />
                                        </td>

                                        <!-- TJM -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.Tjm" />
                                        </td>

                                        <!-- Montant revente (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end" value="@((r.MontantRevente ?? 0m).ToString("N2"))" readonly />
                                        </td>

                                        <!-- Markup % (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end"
                                                   value="@(r.MarkupPercent.HasValue ? (r.MarkupPercent.Value * 100m).ToString("N2") + " %" : "")"
                                                   readonly />
                                        </td>

                                        <!-- Commentaire -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Commentaire" />
                                        </td>

                                        <!-- Supprimer -->
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeletePrestaAsync(r)">❌</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td>TOTAL</td>
                                <td></td> <!-- Société -->
                                <td class="text-end">@sumCoutJour.ToString("N2")</td>
                                <td class="text-end">@sumNbj.ToString("N2")</td>
                                <td class="text-end">@totalCoutP.ToString("N2")</td>
                                <td class="text-end">@sumTjm.ToString("N2")</td>
                                <td class="text-end">@totalReventeP.ToString("N2")</td>
                                <td class="text-end">@((markupGlobalP.HasValue ? (markupGlobalP.Value * 100m).ToString("N2") + " %" : ""))</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Frais</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddFraisRow">Ajouter une ligne</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveFraisAsync">Enregistrer</button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        @{
                            var fraisRows = frais ?? new List<FraisItem>();
                            decimal totalMontant = fraisRows.Sum(f => f.Montant ?? 0m);
                            decimal totalRefacture = fraisRows.Sum(f => f.MontantRefacture ?? 0m);
                        }

                        <thead class="table-light">
                            <tr>
                                <th>Libellé frais</th>
                                <th class="text-end">Coût unitaire (HT)</th>
                                <th class="text-end">Quantité</th>
                                <th class="text-end">Montant (HT)</th>
                                <th class="text-end">Montant refacturé (HT)</th>
                                <th>Commentaire</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (fraisRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">Aucun frais — cliquez « Ajouter une ligne ».</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in fraisRows)
                                {
                                    <tr>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="r.Libelle" /></td>
                                        <td><InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.CoutUnitaire" /></td>
                                        <td><InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.Quantite" /></td>
                                        <td class="text-end">@((r.Montant ?? 0m).ToString("N2"))</td>
                                        <td><InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.MontantRefacture" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="r.Commentaire" /></td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteFraisAsync(r)">❌</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td>Total</td>
                                <td></td>
                                <td></td>
                                <td class="text-end">@totalMontant.ToString("N2")</td>
                                <td class="text-end">@totalRefacture.ToString("N2")</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>




    }
@* --- Onglet 5 : Planning & Jalons --- *@
else if (activeTab == "planning")
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Planning & Jalons</span>
            <button class="btn btn-sm btn-primary" @onclick="() => SavePlanningAsync(currentYear)">
                Enregistrer
            </button>
        </div>

        @if (!string.IsNullOrEmpty(planningSaveInfo))
        {
            <div class="alert alert-info py-1 my-2">@planningSaveInfo</div>
        }

        <div class="card-body">

            @* ================== TABLEAU PLANNING (Profils) ================== *@
            @if (project?.Profils is null || project.Profils.Count == 0)
            {
                <div class="text-muted">Aucun profil — ajoutez des lignes dans l’onglet « Ressources & Charges ».</div>
            }
            else
            {
                // Variables/calculs (inchangés)
                var planYear = project.Profils.First().PlanningYear;

                var culture = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                string LabelMois(int month) =>
                    culture.DateTimeFormat.GetAbbreviatedMonthName(month) + "." + (planYear % 100).ToString("00");

                decimal[] totalParMois = new decimal[12];
                decimal totalChargeTousProfils = 0m;
                decimal totalSaisieMoisTousProfils = 0m;

                foreach (var r in project.Profils)
                {
                    for (int m = 0; m < 12; m++)
                        totalParMois[m] += r.Months?[m] ?? 0m;

                    totalChargeTousProfils += r.ChargeJh ?? 0m;
                    totalSaisieMoisTousProfils += (r.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                }

                decimal totalEcartTousProfils = totalSaisieMoisTousProfils - totalChargeTousProfils;

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            @* Barre nav année en bleu clair, sans <div> dans <thead> *@
                            <tr class="table-primary">
                                @* 3 colonnes fixes + 12 mois = 15 colonnes totales
                                   On découpe en 3 zones : gauche(5), centre(5), droite(5). *@
                                <th colspan="5" class="p-2 text-start">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ChangeYearAsync(-1)">
                                        ← Année précédente
                                    </button>
                                </th>
                                <th colspan="5" class="p-2 text-center fw-semibold">
                                    Planning @currentYear
                                </th>
                                <th colspan="5" class="p-2 text-end">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ChangeYearAsync(1)">
                                        Année suivante →
                                    </button>
                                </th>
                            </tr>

                            @* Ligne de titres en bleu clair *@
                            <tr class="table-primary">
                                <th>Profil</th>
                                <th>Charge par profil</th>
                                <th>Écart</th>
                                @for (int month = 1; month <= 12; month++)
                                {
                                    var label = new DateTime(currentYear, month, 1)
                                        .ToString("MMM.yy", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
                                    <th class="text-end">@label</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in project!.Profils)
                            {
                                var sommeMois = (row.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                                var chargeProfil = row.ChargeJh ?? 0m;
                                var ecart = sommeMois - chargeProfil;

                                <tr>
                                    <td>
                                        <input class="form-control-plaintext form-control-sm"
                                               value="@row.Profil"
                                               readonly
                                               tabindex="-1" />
                                    </td>
                                    <td class="text-end">@chargeProfil.ToString("N2")</td>
                                    <td class="text-end @(ecart == 0 ? "" : (ecart > 0 ? "text-success" : "text-danger"))">
                                        @ecart.ToString("N2")
                                    </td>

                                    @for (int m = 0; m < 12; m++)
                                    {
                                        var mm = m;
                                        <td class="text-end">
                                            <InputNumber TValue="decimal?"
                                                         class="form-control form-control-sm text-end"
                                                         Value="row.Months[mm]"
                                                         ValueChanged="@(v => { row.Months[mm] = v; planningDirty = true; })"
                                                         ValueExpression="@(() => row.Months[mm])" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                        <tfoot class="table-primary">
                            <tr class="fw-semibold">
                                <td>TOTAL JH</td>
                                <td class="text-end">@totalChargeTousProfils.ToString("N2")</td>
                                <td class="text-end">@totalEcartTousProfils.ToString("N2")</td>
                                @for (int m = 0; m < 12; m++)
                                {
                                    <td class="text-end">@totalParMois[m].ToString("N2")</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @* ================== TABLEAU PHASES ================== *@
            @{
                // Année d’affichage (on prend celle de la 1ʳᵉ ligne ou l’année courante)
                var phasesYear = phasePlans.FirstOrDefault()?.Year ?? DateTime.UtcNow.Year;

                var culture2 = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                string LabelMois2(int month) =>
                    culture2.DateTimeFormat.GetAbbreviatedMonthName(month) + "." + (phasesYear % 100).ToString("00");

                // Totaux (par mois / global)
                var totalParMoisPhases = new decimal[12];
                decimal totalChargePhases = 0m;
                decimal totalSaisieMoisPhases = 0m;

                foreach (var p in phasePlans)
                {
                    for (int m = 0; m < 12; m++)
                        totalParMoisPhases[m] += p.Months?[m] ?? 0m;

                    totalChargePhases += p.ChargeJh ?? 0m;
                    totalSaisieMoisPhases += (p.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                }
                var totalEcartPhases = totalSaisieMoisPhases - totalChargePhases;
            }

            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th style="min-width:220px">Phases</th>
                            <th class="text-end" style="width:120px">Charge par phase</th>
                            <th class="text-end" style="width:110px">Écart&nbsp;?</th>
                            @for (int m = 0; m < 12; m++)
                            {
                                <th class="text-end">@LabelMois2(m + 1)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in phasePlans)
                        {
                            var sommeMois = (p.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                            var charge = p.ChargeJh ?? 0m;
                            var ecart = sommeMois - charge;

                            <tr>
                                <td class="align-middle">@Label(p.Phase)</td>
                                <td class="text-end" style="width:120px">
                                    <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                 @bind-Value="p.ChargeJh" />
                                </td>
                                <td class="text-end @(ecart == 0 ? "" : (ecart > 0 ? "text-success" : "text-danger"))">
                                    @ecart.ToString("N2")
                                </td>
                                @for (int m = 0; m < 12; m++)
                                {
                                    var mm = m;
                                    <td class="text-end">
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="p.Months[mm]" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-primary">
                        <tr class="fw-semibold">
                            <td>TOTAL JH</td>
                            <td class="text-end">@totalChargePhases.ToString("N2")</td>
                            <td class="text-end @(totalEcartPhases == 0 ? "" : (totalEcartPhases > 0 ? "text-success" : "text-danger"))">
                                @totalEcartPhases.ToString("N2")
                            </td>
                            @for (int m = 0; m < 12; m++)
                            {
                                <td class="text-end">@totalParMoisPhases[m].ToString("N2")</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            @* ================== ÉCHÉANCIER ================== *@
            <div class="card shadow-sm mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Échéancier</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="EchAddRow">Ajouter un jalon</button>
                        <button class="btn btn-sm btn-primary" @onclick="EchSaveAsync">Enregistrer</button>
                    </div>
                </div>

                <div class="card-body p-0">
                    @{
                        // Calculs de haut de tableau
                        var contrat = project?.ContractAmount ?? 0m;

                        // lignes triées
                        var rows = (echeanciers ?? new())
                            .OrderBy(x => x.BillingYear)
                            .ThenBy(x => x.BillingMonth)
                            .ThenBy(x => x.Id)
                            .ToList();

                        // total % et total montant (normalisation 40 -> 0,40)
                        decimal totalPercent = 0m;
                        decimal totalMontant = 0m;
                        foreach (var rr in rows)
                        {
                            var p = rr.Percent > 1m ? rr.Percent / 100m : rr.Percent;
                            totalPercent += p;
                            totalMontant += p * contrat;
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:70px">N°</th>
                                    <th>Nom échéance</th>
                                    <th class="text-end" style="width:120px">%</th>
                                    <th style="min-width:160px">Mois facturation</th>
                                    <th class="text-end" style="width:180px">Montant à facturation</th>
                                    <th style="width:48px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">
                                            Aucun jalon — cliquez « Ajouter un jalon ».
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var index = 0;
                                    foreach (var row in rows)
                                    {
                                        index++;

                                        // normalisation : 40 -> 0,40
                                        var percentNorm = row.Percent > 1m ? row.Percent / 100m : row.Percent;
                                        var montantRow = percentNorm * contrat;

                                        <tr>
                                            <td class="text-end">@index</td>
                                            <td>
                                                <InputText class="form-control form-control-sm" @bind-Value="row.Label" />
                                            </td>
                                            <td>
                                                <InputNumber TValue="decimal" class="form-control form-control-sm text-end"
                                                             Value="@(row.Percent * 100m)"
                                                             ValueChanged="@( (decimal v) => row.Percent = v/100m )"
                                                             ValueExpression="@(()=>row.Percent)" />
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm"
                                                        value="@EchGetMonthKey(row)"
                                                        @onchange="e => EchSetMonthKey(row, e.Value?.ToString() ?? string.Empty)">
                                                    @foreach (var m in EcheancierMonthOptions)
                                                    {
                                                        <option value="@m.Key">@m.Label</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-end">@montantRow.ToString("N2")</td>
                                            <td class="text-end">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => EchDeleteAsync(row)">❌</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-semibold">
                                    <td></td>
                                    <td class="text-end">TOTAL</td>
                                    <td class="text-end">@((totalPercent * 100m).ToString("N2")) %</td>
                                    <td></td>
                                    <td class="text-end">@totalMontant.ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            @* ================== Vision FAE ================== *@
            <div class="card shadow-sm mt-3">
                <div class="card-header">Vision FAE</div>
                <div class="card-body p-0">
                    @{
                        var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                        var contract = project?.ContractAmount ?? 0m;

                        // Dictionnaire (year,month) -> coût engagé cumulé (dérivé du Planning)
                        var coutCum = FaeBuildCoutEngageCumul();

                        // Jalons triés
                        var jalons = (echeanciers ?? new())
                            .OrderBy(j => j.BillingYear)
                            .ThenBy(j => j.BillingMonth)
                            .ThenBy(j => j.Id)
                            .ToList();

                        decimal factureCum = 0m;
                        decimal lastCout = 0m, lastFact = 0m, lastFae = 0m;
                    }

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-end" style="width:220px">Coût engagé cumulé</th>
                                    <th class="text-end" style="width:220px">Montant facturé cumulé</th>
                                    <th class="text-end" style="width:220px">Montant FAE (€)</th>
                                    <th class="text-end" style="width:160px">Montant FAE (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (jalons.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">Aucun jalon.</td></tr>
                                }
                                else
                                {
                                    foreach (var j in jalons)
                                    {
                                        // % stocké en fraction (0,40). Si certains anciens sont en "40", on protège :
                                        var p = j.Percent > 1m ? j.Percent / 100m : j.Percent;

                                        // Cumul facturé avance au jalon
                                        factureCum += p * contract;

                                        // Coût engagé cumulé à la fin du mois du jalon (ou dernier mois <=)
                                        var ceCumul = GetCoutCumuleA(coutCum, j.BillingYear, j.BillingMonth);

                                        // FAE
                                        var fae = ceCumul - factureCum;
                                        var faePct = contract > 0 ? (fae / contract) : (decimal?)null;

                                        lastCout = ceCumul; lastFact = factureCum; lastFae = fae;

                                        <tr>
                                            <td class="text-end">@ceCumul.ToString("N2")</td>
                                            <td class="text-end">@factureCum.ToString("N2")</td>
                                            <td class="text-end">@fae.ToString("N2")</td>
                                            <td class="text-end">@((faePct is null) ? "" : (faePct.Value * 100m).ToString("N2") + " %")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-semibold">
                                    <td class="text-end">@lastCout.ToString("N2")</td>
                                    <td class="text-end">@lastFact.ToString("N2")</td>
                                    <td class="text-end">@lastFae.ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

        </div> @* /.card-body *@
    </div>     @* /.card shadow-sm *@
}              @* /else if (activeTab == "planning") *@





    
}
