// --- profils dynamiques (colonnes) ---
private List<WlProfile> WlGetProfiles()
{
        var list = new List<WlProfile>();
        if (project?.Profils is null) return list;

        foreach (var pr in project.Profils)
        {
            // on ne garde que les profils qui ont l'ID PERSISTANT en BD
            if (pr.DbRowId is not int pid) continue;

            // coût interne & TJM (existant dans ton code)
            decimal coutJour = (pr.Prcs ?? pr.Cjm ?? 0m);
            if (pr.Entite == EntiteType.CESSION)
                coutJour += (pr.FraisDeplacementSiCession ?? 0m);

            decimal tjm = pr.Tjm ?? coutJour;
            string name = string.IsNullOrWhiteSpace(pr.Profil) ? $"Profil {pid}" : pr.Profil;

            // ⚠️ on fixe bien l'ID utilisé par la BD (pid)
            list.Add(new WlProfile(pid, name, coutJour, tjm));

        }

        return list;
}


// --- ordre d’affichage + re-séquencement ---
private IEnumerable<WorkloadItem> WlOrderedRows() => wlRows.OrderBy(x => x.OrderIndex);
private void WlResequence()
{
        int i = 1;
        foreach (var r in wlRows.OrderBy(x => x.OrderIndex))
            r.OrderIndex = i++;
}

// --- affichage ID hiérarchique (1, 1.1…) ---
private string WlDisplayId(WorkloadItem r)
{
        var parents = wlRows.Where(x => x.ParentId is null).OrderBy(x => x.OrderIndex).ToList();

        if (r.ParentId is null)
        {
            var pi = parents.FindIndex(x => x.Id == r.Id) + 1;
            return pi.ToString();
        }
        else
        {
            var parent = wlRows.FirstOrDefault(x => x.Id == r.ParentId);
            if (parent is null) return "?";
            var pi = parents.FindIndex(x => x.Id == parent.Id) + 1;

            var children = wlRows.Where(x => x.ParentId == parent.Id).OrderBy(x => x.OrderIndex).ToList();
            var ci = children.FindIndex(x => x.Id == r.Id) + 1;
            return $"{pi}.{ci}";
        }
}

// --- actions "menu ⋮" : insérer / supprimer ---
private async Task WlInsertParentBelowAt(WorkloadItem r){
        int nextOrder;
        if (r.ParentId is null)
        {
            // r = parent -> insérer après tout le bloc (parent + enfants)
            int after = wlRows
                .Where(x => x.Id == r.Id || x.ParentId == r.Id)
                .Select(x => x.OrderIndex)
                .DefaultIfEmpty(r.OrderIndex)
                .Max();
            nextOrder = after + 1;
        }
        else
        {
            // r = enfant -> insérer juste après cet enfant
            nextOrder = r.OrderIndex + 1;
        }

        foreach (var it in wlRows.Where(x => x.OrderIndex >= nextOrder))
            it.OrderIndex++;

        var newParent = new WorkloadItem
    {
        Id = Guid.NewGuid(),
        ProjectId = project!.Id,
        ParentId = null,
        OrderIndex = nextOrder
    };
        wlRows.Add(newParent);

        WlResequence();
        EnsureSeedRow();
        wlMenuOpenFor = null;
        await InvokeAsync(StateHasChanged);
}

private async Task WlInsertChildBelowAt(WorkloadItem r)
{
        var parent = (r.ParentId is null) ? r : wlRows.FirstOrDefault(x => x.Id == r.ParentId);
        if (parent is null) return;

        int nextOrder = (r.ParentId is null)
            ? wlRows.Where(x => x.ParentId == parent.Id)
                   .Select(x => x.OrderIndex)
                   .DefaultIfEmpty(parent.OrderIndex)
                   .Max() + 1
            : r.OrderIndex + 1;

        foreach (var it in wlRows.Where(x => x.OrderIndex >= nextOrder))
            it.OrderIndex++;

        var child = new WorkloadItem
    {
        Id = Guid.NewGuid(),
        ProjectId = project!.Id,
        ParentId = parent.Id,
        OrderIndex = nextOrder,
        Lot = parent.Lot,
        GroupCode = parent.GroupCode
    };
        wlRows.Add(child);


        WlResequence();
        EnsureSeedRow();
        wlMenuOpenFor = null;
        await InvokeAsync(StateHasChanged);
}

private void WlDeleteRow(WorkloadItem r)
{
        // 1) L’Id à supprimer : la ligne + ses enfants si c’est un parent
        var ids = wlRows
            .Where(x => x.Id == r.Id || x.ParentId == r.Id)
            .Select(x => x.Id)
            .ToList();

        // 2) Marquer pour suppression en BD au clic "Enregistrer"
        foreach (var id in ids)
            wlDeleted.Add(id);

        // 3) Retirer immédiatement de l’UI
        wlRows.RemoveAll(x => ids.Contains(x.Id));

        // 4) Resequencer l’affichage si tu as une numérotation/ordre
        WlResequence();

        // ⚠️ NE PAS recréer automatiquement un parent ici.
        // EnsureSeedRow();  // <-- on supprime cette ligne pour éviter la réapparition

        wlMenuOpenFor = null;
        StateHasChanged();
}
