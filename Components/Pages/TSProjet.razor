                                            <InputNumber TValue="decimal?"
                                                         class="form-control form-control-sm"
                                                         Value="row.ChargeJh"
                                                         ValueChanged="@(v => { row.ChargeJh = v; RecomputeAll(); })"
                                                         ValueExpression="(() => row.ChargeJh)" />
                                        </td>

                                        <!-- CA (€) (readonly) -->
                                        <td><input class="form-control form-control-sm" value="@(row.CaEuro?.ToString("N2"))" readonly /></td>

                                        <!-- COUT Exakis Nelite (€) (readonly) -->
                                        <td><input class="form-control form-control-sm" value="@(row.CoutExakisNeliteEuro?.ToString("N2"))" readonly /></td>

                                        <!-- COUT AGENCE (€) (readonly) -->
                                        <td><input class="form-control form-control-sm" value="@(row.CoutAgenceEuro?.ToString("N2"))" readonly /></td>

                                        <!-- %jh PROFIL (readonly) -->
                                        <td><input class="form-control form-control-sm" value="@(row.PercentJhProfil is null ? "" : (row.PercentJhProfil.Value * 100m).ToString("N2") + " %")" readonly /></td>

