                        <div class="col-md-6"><strong>Agence</strong><div>@project.Agency</div></div>
                        <div class="col-md-6"><strong>Service line</strong><div>@project.ServiceLine</div></div>
                        <div class="col-md-6"><strong>Directeur d’agence</strong><div>@project.AgencyDirector</div></div>
                        <div class="col-md-6"><strong>Responsable SL</strong><div>@project.ServiceLineManager</div></div>
                        <div class="col-md-6"><strong>Commercial</strong><div>@project.SalesRep</div></div>
                        <div class="col-md-6"><strong>Chef de projet back (Unit4)</strong><div>@project.BackProjectManager</div></div>

                        <div class="col-md-3"><strong>Type de contrat</strong><div>@project.ContractType</div></div>
                        <div class="col-md-3"><strong>Montant du contrat</strong><div>@Money(project.ContractAmount)</div></div>
                        <div class="col-md-3"><strong>dont CA back</strong><div>@Money(project.ContractCaBack)</div></div>
                        <div class="col-md-3"><strong>Montant du contrat back</strong><div>@Money(project.ContractBackAmount)</div></div>

                    </div>
