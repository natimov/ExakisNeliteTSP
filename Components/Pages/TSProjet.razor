                    <button class="btn btn-sm btn-primary" @onclick="SavePrestasAsync">Enregistrer</button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        @{
                            // Noms uniques pour éviter les collisions avec d'autres tableaux
                            var prestaRows = prestas ?? new List<AchatPrestataireItem>();

                            decimal sumCoutJour = prestaRows.Sum(r => r.CoutJour ?? 0m);
                            decimal sumNbj = prestaRows.Sum(r => r.NbJours ?? 0m);
                            decimal sumTjm = prestaRows.Sum(r => r.Tjm ?? 0m);

                            decimal totalCoutP = prestaRows.Sum(r => r.TotalCout ?? 0m);
                            decimal totalReventeP = prestaRows.Sum(r => r.MontantRevente ?? 0m);
                            decimal? markupGlobalP = totalReventeP > 0 ? (totalReventeP - totalCoutP) / totalReventeP : (decimal?)null;
                        }

                        <thead class="table-light">
                            <tr>
                                <th class="col-wide">Prestation</th>
                                <th class="col-wide">Société</th>
                                <th class="col-narrow text-end">Coût jour (HT)</th>
                                <th class="col-narrow text-end">Nbj</th>
                                <th class="text-end">Total coût (HT)</th>
                                <th class="col-narrow text-end">TJM (HT)</th>
                                <th class="text-end">Montant revente (HT)</th>
                                <th class="text-end">Markup (%)</th>
                                <th class="col-wide">Commentaire</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (prestaRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-3">Aucune ligne — cliquez « Ajouter une ligne ».</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in prestaRows)
                                {
                                    <tr>
                                        <!-- Prestation -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Prestation" />
                                        </td>

                                        <!-- Société -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Societe" />
                                        </td>

                                        <!-- Coût jour -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.CoutJour" />
                                        </td>

                                        <!-- Nbj -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.NbJours" />
                                        </td>

                                        <!-- Total coût (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end" value="@((r.TotalCout ?? 0m).ToString("N2"))" readonly />
                                        </td>

                                        <!-- TJM -->
                                        <td class="col-narrow">
                                            <InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.Tjm" />
                                        </td>

                                        <!-- Montant revente (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end" value="@((r.MontantRevente ?? 0m).ToString("N2"))" readonly />
                                        </td>

                                        <!-- Markup % (readonly = calculé) -->
                                        <td class="text-end">
                                            <input class="form-control form-control-sm text-end"
                                                   value="@(r.MarkupPercent.HasValue ? (r.MarkupPercent.Value * 100m).ToString("N2") + " %" : "")"
                                                   readonly />
                                        </td>

                                        <!-- Commentaire -->
                                        <td class="col-wide">
                                            <InputText class="form-control form-control-sm" @bind-Value="r.Commentaire" />
                                        </td>

                                        <!-- Supprimer -->
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeletePrestaAsync(r)">❌</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                        <tfoot class="table-light">
                            <tr class="fw-semibold">
                                <td>TOTAL</td>
                                <td></td> <!-- Société -->
                                <td class="text-end">@sumCoutJour.ToString("N2")</td>
                                <td class="text-end">@sumNbj.ToString("N2")</td>
                                <td class="text-end">@totalCoutP.ToString("N2")</td>
                                <td class="text-end">@sumTjm.ToString("N2")</td>
                                <td class="text-end">@totalReventeP.ToString("N2")</td>
                                <td class="text-end">@((markupGlobalP.HasValue ? (markupGlobalP.Value * 100m).ToString("N2") + " %" : ""))</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Frais</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddFraisRow">Ajouter une ligne</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveFraisAsync">Enregistrer</button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        @{
                            var fraisRows = frais ?? new List<FraisItem>();
                            decimal totalMontant = fraisRows.Sum(f => f.Montant ?? 0m);
                            decimal totalRefacture = fraisRows.Sum(f => f.MontantRefacture ?? 0m);
                        }

                        <thead class="table-light">
                            <tr>
                                <th>Libellé frais</th>
                                <th class="text-end">Coût unitaire (HT)</th>
                                <th class="text-end">Quantité</th>
                                <th class="text-end">Montant (HT)</th>
                                <th class="text-end">Montant refacturé (HT)</th>
                                <th>Commentaire</th>
                                <th style="width:48px"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (fraisRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3">Aucun frais — cliquez « Ajouter une ligne ».</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in fraisRows)
                                {
                                    <tr>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="r.Libelle" /></td>
                                        <td><InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.CoutUnitaire" /></td>
                                        <td><InputNumber TValue="decimal?" class="form-control form-control-sm text-end" @bind-Value="r.Quantite" /></td>
                                        <td class="text-end">@((r.Montant ?? 0m).ToString("N2"))</td>
