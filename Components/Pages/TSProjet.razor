    // --- Total JH pour une PHASE donnée (toutes charges de tous profils) ---
    private decimal WlTotalJHForPhase(ProjectPhase phase)
    {
        return wlRows
        .Where(r => !string.IsNullOrWhiteSpace(r.Phase))
        .Where(r => TryParsePhase(r.Phase, out var ph) && ph == phase)
        .Sum(r => r.ChargesByProfile.Values.Sum());
    }


// --- propagation Lot/GroupCode du parent vers enfants ---
private void WlPropagateFromParent(WorkloadItem parent, bool lot = true, bool groupCode = true)
{
        foreach (var c in wlRows.Where(x => x.ParentId == parent.Id))
        {
            if (lot) c.Lot = parent.Lot;
            if (groupCode) c.GroupCode = parent.GroupCode;
        }
}

// --- édition des charges par profil ---
private Task WlUpdateAlloc(WorkloadItem r, int profileId, string? raw)
{
        // accepte 1,5 et 1.5
        decimal v = 0m;
        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.GetCultureInfo("fr-FR"), out v))
            decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out v);

        if (v < 0) v = 0m;
        r.ChargesByProfile[profileId] = v;  // MAJ en mémoire seulement
        return Task.CompletedTask;          // PAS d'appel au service ici
}

// --- agrégations (JH, coûts, valorisation) ---
private decimal WlSumCharges(WorkloadItem row, List<WlProfile> profs)
                => profs.Sum(p => row.ChargesByProfile.TryGetValue(p.ProfileId, out var v) ? v : 0m);

private decimal WlSumChildrenCharges(Guid parentId, int profileId)
                => wlRows.Where(c => c.ParentId == parentId)
                         .Sum(c => c.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m);

private decimal WlCostFor(WorkloadItem row, int profileId, decimal costPerDay)
{
        var jh = row.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m;
        return jh * costPerDay;
}

private decimal WlSumChildrenCosts(Guid parentId, int profileId, decimal costPerDay)
                => wlRows.Where(c => c.ParentId == parentId)
                         .Sum(c => WlCostFor(c, profileId, costPerDay));

private decimal WlValueFor(WorkloadItem row, int profileId, decimal pricePerDay)
{
        var jh = row.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m;
        return jh * pricePerDay;
}

private decimal WlSumChildrenValues(Guid parentId, int profileId, decimal pricePerDay)
                => wlRows.Where(c => c.ParentId == parentId).Sum(c => WlValueFor(c, profileId, pricePerDay));

private decimal WlSumRowCosts(WorkloadItem row, List<WlProfile> profs)
                => profs.Sum(p => WlCostFor(row, p.ProfileId, p.CostPerDay));

private decimal WlSumRowValues(WorkloadItem row, List<WlProfile> profs)
                => profs.Sum(p => WlValueFor(row, p.ProfileId, p.PricePerDay));

// --- totaux (entête) ---
private IEnumerable<WorkloadItem> WlLeafRows() => wlRows.Where(r => r.ParentId is not null);

private decimal WlTotalChargesForProfile(int profileId)
                => WlLeafRows().Sum(r => r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m);

private decimal WlTotalCostsForProfile(int profileId, decimal costPerDay)
                => WlLeafRows().Sum(r => (r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m) * costPerDay);

private decimal WlTotalValuesForProfile(int profileId, decimal pricePerDay)
                => WlLeafRows().Sum(r => (r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m) * pricePerDay);

private decimal WlGrandTotalJH() => WlLeafRows().Sum(r => r.ChargesByProfile.Values.Sum());
private decimal WlGrandTotalCost(List<WlProfile> profs) => WlLeafRows().Sum(r => WlSumRowCosts(r, profs));
private decimal WlGrandTotalValue(List<WlProfile> profs) => WlLeafRows().Sum(r => WlSumRowValues(r, profs));



// 1) Options de PHASE = toutes les valeurs de l’énum (hors None)
private IReadOnlyList<ProjectPhase> PhaseEnumOptions =>
                Enum.GetValues<ProjectPhase>().Where(p => p != ProjectPhase.None).ToList();

// 2) Options d’ETAPE pour une PHASE donnée
//    - si un mapping est défini ci-dessous, on filtre
//    - sinon, on affiche toutes les étapes (hors None)
private IReadOnlyList<ProjectEtape> EtapeEnumOptionsFor(ProjectPhase _)
                => Enum.GetValues<ProjectEtape>()
                       .Where(e => e != ProjectEtape.None)
                       .ToList();

// 3) Mapping PHASE -> ETAPES (remplis au fur et à mesure ; à défaut : toutes les étapes)
// 3) Mapping PHASE -> ETAPES (uniquement avec les membres de ton enum ProjectEtape)
private static readonly Dictionary<ProjectPhase, ProjectEtape[]> PhaseToEtapes = new()
{
    { ProjectPhase.Pilotage, new[] {
        ProjectEtape.PilotageProjet
    }},
    { ProjectPhase.Conception, new[] {
        ProjectEtape.AnalyseDeLExistant,
        ProjectEtape.ConceptionGenerale,
        ProjectEtape.ConceptionTechniqueDetaillee,
        ProjectEtape.ConceptionFonctionnelleDetaillee,
        ProjectEtape.EgornomieGraphisme,
        ProjectEtape.CahierDeRecette
    }},
    { ProjectPhase.Construction, new[] {
        ProjectEtape.DeveloppementTestsUnitaires,
        ProjectEtape.RepriseDeContenu,
        ProjectEtape.Support
    }},
    { ProjectPhase.Validation, new[] {
        ProjectEtape.TestsIntegrationsARecetteInterne,
        ProjectEtape.AssistanceRecette
    }},
    { ProjectPhase.Finalisation, new[] {
        ProjectEtape.LivraisonAInstallationAMiseEnOeuvre,
        ProjectEtape.Generalisation,
        ProjectEtape.Formation
    }},
    { ProjectPhase.Garantie, new[] {
        ProjectEtape.Garantie
    }},
    { ProjectPhase.TMA, new[] {
        ProjectEtape.Support
    }},
    { ProjectPhase.Provision, new[] {
        ProjectEtape.ProvisionPourRisque
    }},
};

// 4) Conversion string (stockée dans ) <-> enum
private static bool TryParsePhase(string? s, out ProjectPhase phase)
                => Enum.TryParse<ProjectPhase>(s ?? "", ignoreCase: true, out phase);

private static bool TryParseEtape(string? s, out ProjectEtape etape)
                => Enum.TryParse<ProjectEtape>(s ?? "", ignoreCase: true, out etape);

// 5) Handlers des selects
private void OnPhaseChanged(WorkloadItem row, ChangeEventArgs e)
{
        row.Phase = e.Value?.ToString() ?? "";
        StateHasChanged();
}

private void OnEtapeChanged(WorkloadItem row, ChangeEventArgs e)
{
        row.Etape = e.Value?.ToString() ?? "";
}


