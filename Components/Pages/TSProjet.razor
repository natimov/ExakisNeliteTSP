    private bool isSaving;
private bool isSwitchingYear;

private async Task SavePlanningAsync(int? year = null)
{
    if (project is null || project.Profils is null) return;

    isSaving = true;
    planningSaveInfo = null;

    try
    {
        // 1) On sauve explicitement l'année demandée, sinon l'année affichée
        var y = year ?? currentYear;

        // 2) Items à sauver : uniquement les lignes avec un Id BD
        var items = project.Profils
            .Where(p => p.DbRowId is int)
            .Select(p => (ProfilRowId: p.DbRowId!.Value, Months: p.Months ?? new decimal?[12]))
            .ToList();

        if (items.Count == 0)
        {
            planningSaveInfo = "[SavePlanning] 0 item à sauvegarder (DbRowId manquants ?)";
            return;
        }

        await ProfileMonthlySvc.SaveAsync(project.Id, y, items);
        planningSaveInfo = $"[SavePlanning] OK ({y})";
        planningDirty = false;              // ✅ on n’a plus de modifs en attente
    }
    catch (Exception ex)
    {
        planningSaveInfo = "[SavePlanning] EXCEPTION: " + ex.Message;
        Console.WriteLine(ex);
    }
    finally
    {
        isSaving = false;
        StateHasChanged();
    }
}


