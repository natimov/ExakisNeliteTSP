    // ====================== VISION FAE – CALCULS ======================
    
    private Dictionary<(int year, int month), decimal> FaeBuildCoutEngageCumul()
    {
        var result = new Dictionary<(int, int), decimal>();

        if (project?.Profils is null || project.Profils.Count == 0)
            return result;

        // (1) Recalcule PRCS/CJM si tu le fais déjà
        ProfilComputeService.ComputeAll(project);

        // (2) Début d’horizon = année de planning (fallback = année courante)
        int startYear = project.Profils.First().PlanningYear > 0
            ? project.Profils.First().PlanningYear
            : DateTime.UtcNow.Year;
        int startMonth = 1; // si tu as un mois de départ, remplace par ce champ

        var start = new DateTime(startYear, startMonth, 1);

        // (3) Fin d’horizon = dernier jalon (min 12 mois)
        var lastMilestone = (echeanciers ?? new())
            .Where(e => e.BillingYear > 0 && e.BillingMonth >= 1 && e.BillingMonth <= 12)
            .Select(e => new DateTime(e.BillingYear, e.BillingMonth, 1))
            .DefaultIfEmpty(start)
            .Max();

        var end = lastMilestone < start.AddMonths(11) ? start.AddMonths(11) : lastMilestone;

        // (4) Nombre de mois à calculer
        int monthsCount = ((end.Year - start.Year) * 12) + (end.Month - start.Month) + 1;

        decimal cumul = 0m;

        // (5) Boucle calendrier multi-années
        for (int i = 0; i < monthsCount; i++)
        {
            var dt = start.AddMonths(i);
            decimal coutMois = 0m;

            foreach (var r in project.Profils)
            {
                // JH du mois 'dt' via la map multi-années (couvre 2026)
                decimal jh = 0m;
                if (r.DbRowId is int pid && _jhAllYears.TryGetValue((pid, dt.Year, dt.Month), out var jhVal))
                jh = jhVal;



                // Coût/jour : règle Excel = PRCS prioritaire sinon CJM
                decimal coutJour = (r.Prcs ?? r.Cjm ?? 0m);

                // + frais/jour si Entite == CESSION (si Excel le fait chez toi)
                if (r.Entite == EntiteType.CESSION)
                    coutJour += (r.FraisDeplacementSiCession ?? 0m);

                // (si Excel exclut certains profils, filtre ici)
                coutMois += jh * coutJour;
            }

            cumul += coutMois;
            result[(dt.Year, dt.Month)] = Math.Round(cumul, 2, MidpointRounding.AwayFromZero);
        }

        return result;
    }



    // Facturé cumulé par mois depuis l’Échéancier
    private Dictionary<(int year, int month), decimal> FaeBuildFactureCumul()
    {
        var dict = new SortedDictionary<(int, int), decimal>();
        if (project is null) return new Dictionary<(int, int), decimal>();

        var contrat = project.ContractAmount ?? 0m;

        foreach (var e in echeanciers)
        {
            var amount = contrat * e.Percent;
            var key = (e.BillingYear, e.BillingMonth);
            dict[key] = dict.TryGetValue(key, out var cur) ? cur + amount : amount;
        }

        decimal cumul = 0m;
        var outDict = new Dictionary<(int, int), decimal>();
        foreach (var kv in dict)
        {
            cumul += kv.Value;
            outDict[kv.Key] = cumul;
        }
        return outDict;
    }

    // Périmètre des mois à afficher : planning (12 mois) + mois d’échéancier
    private List<(int year, int month)> FaeBuildRange()
    {
        var keys = new HashSet<(int, int)>();

        if (project?.Profils?.FirstOrDefault() is { } first)
        {
            var y = first.PlanningYear == 0 ? DateTime.UtcNow.Year : first.PlanningYear;
            for (int m = 1; m <= 12; m++) keys.Add((y, m));
        }

        foreach (var e in echeanciers) keys.Add((e.BillingYear, e.BillingMonth));

        return keys.OrderBy(k => k.Item1).ThenBy(k => k.Item2).ToList(); // Item1=year, Item2=month
    }
    // Récupère le coût engagé cumulé à la fin d’un mois (ou le dernier mois disponible avant)
    private decimal GetCoutCumuleA(Dictionary<(int year, int month), decimal> coutCum,
                                   int year, int month)
    {
        // Si la clé existe, on renvoie direct
        if (coutCum.TryGetValue((year, month), out var v)) return v;

        // Sinon on prend le dernier mois <= demandé
        var key = coutCum.Keys
            .Where(k => (k.year < year) || (k.year == year && k.month <= month))
            .OrderBy(k => k.year).ThenBy(k => k.month)
            .LastOrDefault();

        return key == default ? 0m : coutCum[key];
    }

