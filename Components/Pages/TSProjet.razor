private int currentYear;           // année visible dans le tableau
private bool planningDirty = false; // si des cases ont été modifiées
private async Task LoadPlanningYearAsync(int year)
{
    if (project is null) return;

    var monthDict = await ProfileMonthlySvc.LoadAsync(project.Id, year);

    foreach (var r in project.Profils)
    {
        r.PlanningYear = year;
        r.Months ??= new decimal?[12];

        if (r.DbRowId is int id)
        {
            for (int m = 1; m <= 12; m++)
            {
                r.Months[m - 1] = monthDict.TryGetValue((id, m), out var val) ? val : null;
            }
        }
        else
        {
            for (int m = 0; m < 12; m++)
                r.Months[m] = r.Months[m]; // laisse tel quel (ou null)
        }
    }
}

//fonction année pl
private async Task ChangeYearAsync(int delta)
{
    if (project is null) return;

    // 1) Sauvegarde auto si l'utilisateur a modifié quelque chose
    if (planningDirty)
        await SavePlanningAsync(currentYear); // <— on fige l’année courante

    // 2) Calcule l’année cible et charge ses valeurs
    var targetYear = currentYear + delta;
    await LoadPlanningYearAsync(targetYear);

    // 3) Bascule l’état
    currentYear = targetYear;
    planningDirty = false;

    StateHasChanged();
}

