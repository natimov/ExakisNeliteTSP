        await ProjectTjmSvc.SaveAsync(project.Id, projectTjms);
        // (optionnel) afficher un toast "TJM enregistrés"
    }

    // Permet de savoir quel tableau (catégorie) est en mode édition
    private HashSet<string> editingCats = new();

    // Helper d'affichage/édition d'un tableau référentiel
    private RenderFragment RenderRefTableSimple(string title, string category, string[] columns) => @<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5>@title</h5>
        @if (!editingCats.Contains(category))
                {
        <button class="btn btn-outline-secondary btn-sm"
                @onclick="() => editingCats.Add(category)">
            Modifier
        </button>
                }
                else
                {
        <div>
            <button class="btn btn-primary btn-sm me-2"
                    @onclick="async () => { await SaveTjmAsync(); editingCats.Remove(category); }">
                Enregistrer
            </button>
            <button class="btn btn-link btn-sm text-muted"
                    @onclick="() => editingCats.Remove(category)">
                Annuler
            </button>
        </div>
                }
    </div>

    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>Profil</th>
                @foreach (var col in columns) {
                <th>@col</th>
                                }
            </tr>
        </thead>
        <tbody>
            @foreach (var g in projectTjms.Where(x => x.Category == category).GroupBy(x => x.Profile).OrderBy(g => g.Key))
                        {
            <tr>
                <td>@g.Key</td>
                @foreach (var col in columns)
                                {
                                var cell = g.FirstOrDefault(x => x.Location == col);
                                if (cell == null)
                                {
                                cell = new ProjectTjmItem
                                {
                                ProjectId = project.Id,
                                Category  = category,
                                Profile   = g.Key,
                                Location  = col,
                                Tjm       = 0m
                                };
                projectTjms.Add(cell);
                                }

                <td>
                    @if (editingCats.Contains(category))
                    {
                        <InputNumber @bind-Value="cell.Tjm" class="form-control form-control-sm" />
                    }
                    else
                    {
                        @($"{cell.Tjm:0} €")
                    }
                </td>
                                }
            </tr>
                        }
        </tbody>
    </table>
</div>;
private List<AchatPrestataireItem> prestas = new();

private async Task LoadPrestasAsync()
{
    if (project is null) return;
    prestas = await PrestasSvc.LoadAsync(project.Id);
}

private void AddPrestaRow()
{
    if (project is null) return;
    prestas.Add(new AchatPrestataireItem
    {
        ProjectId = project.Id,
        Societe = "",
        CoutJour = null,
        NbJours = 1,
        Tjm = null,
        Commentaire = null
    });
}

private async Task SavePrestasAsync()
{
    if (project is null) return;
    await PrestasSvc.SaveAsync(project.Id, prestas);
    // Optionnel : recharger pour resynchroniser avec la BDD
    // prestas = await PrestasSvc.LoadAsync(project.Id);
}

private async Task DeletePrestaAsync(AchatPrestataireItem row)
{
    if (row.Id == 0)
    {
        prestas.Remove(row);
    }
    else
    {
        await PrestasSvc.DeleteAsync(row.Id);
        prestas.Remove(row);
    }
}





