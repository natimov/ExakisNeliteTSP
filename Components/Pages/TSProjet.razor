// --- profils dynamiques (colonnes) ---
private List<WlProfile> WlGetProfiles()
{
    var list = new List<WlProfile>();
    if (project?.Profils is null) return list;

    foreach (var pr in project.Profils)
    {
        // on ne garde que les profils qui ont l'ID PERSISTANT en BD
        if (pr.DbRowId is not int pid) continue;

        // coût interne & TJM (existant dans ton code)
        decimal coutJour = (pr.Prcs ?? pr.Cjm ?? 0m);
        if (pr.Entite == EntiteType.CESSION)
            coutJour += (pr.FraisDeplacementSiCession ?? 0m);

        decimal tjm = pr.Tjm ?? coutJour;
        string name = string.IsNullOrWhiteSpace(pr.Profil) ? $"Profil {pid}" : pr.Profil;

        // ⚠️ on fixe bien l'ID utilisé par la BD (pid)
        list.Add(new WlProfile(pid, name, coutJour, tjm));

    }

    return list;
}


// --- ordre d’affichage + re-séquencement ---
private IEnumerable<WorkloadItem> WlOrderedRows() => wlRows.OrderBy(x => x.OrderIndex);
private void WlResequence()
{
    int i = 1;
    foreach (var r in wlRows.OrderBy(x => x.OrderIndex))
        r.OrderIndex = i++;
}

// --- affichage ID hiérarchique (1, 1.1…) ---
private string WlDisplayId(WorkloadItem r)
{
    var parents = wlRows.Where(x => x.ParentId is null).OrderBy(x => x.OrderIndex).ToList();

    if (r.ParentId is null)
    {
        var pi = parents.FindIndex(x => x.Id == r.Id) + 1;
        return pi.ToString();
    }
    else
    {
        var parent = wlRows.FirstOrDefault(x => x.Id == r.ParentId);
        if (parent is null) return "?";
        var pi = parents.FindIndex(x => x.Id == parent.Id) + 1;

        var children = wlRows.Where(x => x.ParentId == parent.Id).OrderBy(x => x.OrderIndex).ToList();
        var ci = children.FindIndex(x => x.Id == r.Id) + 1;
        return $"{pi}.{ci}";
    }
}

// --- actions "menu ⋮" : insérer / supprimer ---
private async Task WlInsertParentBelowAt(WorkloadItem r){
    int nextOrder;
    if (r.ParentId is null)
    {
        // r = parent -> insérer après tout le bloc (parent + enfants)
        int after = wlRows
            .Where(x => x.Id == r.Id || x.ParentId == r.Id)
            .Select(x => x.OrderIndex)
            .DefaultIfEmpty(r.OrderIndex)
            .Max();
        nextOrder = after + 1;
    }
    else
    {
        // r = enfant -> insérer juste après cet enfant
        nextOrder = r.OrderIndex + 1;
    }

    foreach (var it in wlRows.Where(x => x.OrderIndex >= nextOrder))
        it.OrderIndex++;

    var newParent = new WorkloadItem
    {
        Id = Guid.NewGuid(),
        ProjectId = project!.Id,
        ParentId = null,
        OrderIndex = nextOrder
    };
    wlRows.Add(newParent);

    WlResequence();
    EnsureSeedRow();
    wlMenuOpenFor = null;
    await InvokeAsync(StateHasChanged);
}

private async Task WlInsertChildBelowAt(WorkloadItem r)
{
    var parent = (r.ParentId is null) ? r : wlRows.FirstOrDefault(x => x.Id == r.ParentId);
    if (parent is null) return;

    int nextOrder = (r.ParentId is null)
        ? wlRows.Where(x => x.ParentId == parent.Id)
               .Select(x => x.OrderIndex)
               .DefaultIfEmpty(parent.OrderIndex)
               .Max() + 1
        : r.OrderIndex + 1;

    foreach (var it in wlRows.Where(x => x.OrderIndex >= nextOrder))
        it.OrderIndex++;

    var child = new WorkloadItem
    {
        Id = Guid.NewGuid(),
        ProjectId = project!.Id,
        ParentId = parent.Id,
        OrderIndex = nextOrder,
        Lot = parent.Lot,
        GroupCode = parent.GroupCode
    };
    wlRows.Add(child);


    WlResequence();
    EnsureSeedRow();
    wlMenuOpenFor = null;
    await InvokeAsync(StateHasChanged);
}

private void WlDeleteRow(WorkloadItem r)
{
    // 1) L’Id à supprimer : la ligne + ses enfants si c’est un parent
    var ids = wlRows
        .Where(x => x.Id == r.Id || x.ParentId == r.Id)
        .Select(x => x.Id)
        .ToList();

    // 2) Marquer pour suppression en BD au clic "Enregistrer"
    foreach (var id in ids)
        wlDeleted.Add(id);

    // 3) Retirer immédiatement de l’UI
    wlRows.RemoveAll(x => ids.Contains(x.Id));

    // 4) Resequencer l’affichage si tu as une numérotation/ordre
    WlResequence();

    // ⚠️ NE PAS recréer automatiquement un parent ici.
    // EnsureSeedRow();  // <-- on supprime cette ligne pour éviter la réapparition

    wlMenuOpenFor = null;
    StateHasChanged();
}


// --- propagation Lot/GroupCode du parent vers enfants ---
private void WlPropagateFromParent(WorkloadItem parent, bool lot = true, bool groupCode = true)
{
    foreach (var c in wlRows.Where(x => x.ParentId == parent.Id))
    {
        if (lot) c.Lot = parent.Lot;
        if (groupCode) c.GroupCode = parent.GroupCode;
    }
}

// --- édition des charges par profil ---
private Task WlUpdateAlloc(WorkloadItem r, int profileId, string? raw)
{
    // accepte 1,5 et 1.5
    decimal v = 0m;
    if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.GetCultureInfo("fr-FR"), out v))
        decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out v);

    if (v < 0) v = 0m;
    r.ChargesByProfile[profileId] = v;  // MAJ en mémoire seulement
    return Task.CompletedTask;          // PAS d'appel au service ici
}

// --- agrégations (JH, coûts, valorisation) ---
private decimal WlSumCharges(WorkloadItem row, List<WlProfile> profs)
    => profs.Sum(p => row.ChargesByProfile.TryGetValue(p.ProfileId, out var v) ? v : 0m);

private decimal WlSumChildrenCharges(Guid parentId, int profileId)
    => wlRows.Where(c => c.ParentId == parentId)
             .Sum(c => c.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m);

private decimal WlCostFor(WorkloadItem row, int profileId, decimal costPerDay)
{
    var jh = row.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m;
    return jh * costPerDay;
}

private decimal WlSumChildrenCosts(Guid parentId, int profileId, decimal costPerDay)
    => wlRows.Where(c => c.ParentId == parentId)
             .Sum(c => WlCostFor(c, profileId, costPerDay));

private decimal WlValueFor(WorkloadItem row, int profileId, decimal pricePerDay)
{
    var jh = row.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m;
    return jh * pricePerDay;
}

private decimal WlSumChildrenValues(Guid parentId, int profileId, decimal pricePerDay)
    => wlRows.Where(c => c.ParentId == parentId).Sum(c => WlValueFor(c, profileId, pricePerDay));

private decimal WlSumRowCosts(WorkloadItem row, List<WlProfile> profs)
    => profs.Sum(p => WlCostFor(row, p.ProfileId, p.CostPerDay));

private decimal WlSumRowValues(WorkloadItem row, List<WlProfile> profs)
    => profs.Sum(p => WlValueFor(row, p.ProfileId, p.PricePerDay));

// --- totaux (entête) ---
private IEnumerable<WorkloadItem> WlLeafRows() => wlRows.Where(r => r.ParentId is not null);

private decimal WlTotalChargesForProfile(int profileId)
    => WlLeafRows().Sum(r => r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m);

private decimal WlTotalCostsForProfile(int profileId, decimal costPerDay)
    => WlLeafRows().Sum(r => (r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m) * costPerDay);

private decimal WlTotalValuesForProfile(int profileId, decimal pricePerDay)
    => WlLeafRows().Sum(r => (r.ChargesByProfile.TryGetValue(profileId, out var v) ? v : 0m) * pricePerDay);

private decimal WlGrandTotalJH() => WlLeafRows().Sum(r => r.ChargesByProfile.Values.Sum());
private decimal WlGrandTotalCost(List<WlProfile> profs) => WlLeafRows().Sum(r => WlSumRowCosts(r, profs));
private decimal WlGrandTotalValue(List<WlProfile> profs) => WlLeafRows().Sum(r => WlSumRowValues(r, profs));



