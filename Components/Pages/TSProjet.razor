private HashSet<Guid> wlDeleted = new();   // Id des lignes à supprimer en BD au prochain "Enregistrer"

private bool saving = false;
private DateTime? lastSavedAt;
private string? saveError;

private async Task SaveWorkloadAsync()
{
        if (project is null) return;
        // 0) d’abord, on supprime en base ce que l’utilisateur a retiré
        if (wlDeleted.Count > 0)
        {
            await WorkloadService.DeleteRowsAsync(wlDeleted);
            wlDeleted.Clear(); // on vide la liste, c’est fait
        }


        // --- Parents : ne pas persister Phase / Étape ---
        foreach (var row in wlRows.Where(x => x.ParentId is null))
        {
            row.Phase = string.Empty;   // ou: null si colonne nullable
            row.Etape = string.Empty;   // ou: null si colonne nullable
        }

        saving = true;
        saveError = null;
        StateHasChanged();

        try
        {
            // 1) UPSERT des lignes
            foreach (var row in wlRows)
                await WorkloadService.UpdateRowAsync(row);

            // 2) Puis les allocations JH (enfants uniquement)
            foreach (var row in wlRows.Where(x => x.ParentId is not null))
                foreach (var kv in row.ChargesByProfile)
                    await WorkloadService.UpdateAllocationAsync(row.Id, kv.Key, kv.Value);

            // 3) Recharger depuis la BD (facultatif mais propre)
            wlRows = await WorkloadService.LoadAsync(project.Id);
            lastSavedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
}

