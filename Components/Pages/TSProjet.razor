// Helpers pour le binding des boutons UI
private Task GoPrevYearAsync() => ChangeYearAsync(-1);
        private Task GoNextYearAsync() => ChangeYearAsync(1);
    private async Task ChangeYearAsync(int delta)
    {
        if (project is null) return;

        // Sauvegarde l’année en cours si des modifs
        if (planningDirty)
            await SavePlanningAsync(currentYear);

        var targetYear = currentYear + delta;

        // 🔧 Recharger les JH pour l’année cible
        _jhAllYears ??= new();
        if (project?.Profils is not null)
        {
            // On recharge depuis le service pour l’année demandée
            var dict = await ProfileMonthlySvc.LoadAsync(project.Id, targetYear);

            foreach (var r in project.Profils)
            {
                if (r.DbRowId is not int pid) continue;

                for (int m = 1; m <= 12; m++)
                {
                    decimal jh = 0m;

                    // On met ce qu’on a trouvé dans la BDD
                    if (dict.TryGetValue((pid, m), out var v1) && v1.HasValue)
                        jh = v1.Value;

                    // Sinon 0
                    _jhAllYears[(pid, targetYear, m)] = jh;
                }
            }
        }

        // Charge les autres infos de l’année (calculs, UI, etc.)
        await LoadPlanningYearAsync(targetYear);

        currentYear = targetYear;
        planningDirty = false;

        StateHasChanged();
    }


