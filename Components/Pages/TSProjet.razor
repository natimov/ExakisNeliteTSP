@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    // JH multi-années : (profilId, year, month 1..12) -> Jours-Homme
    private Dictionary<(int profilId, int year, int month), decimal> _jhAllYears = new();

    
    private readonly System.Globalization.CultureInfo fro =
        System.Globalization.CultureInfo.GetCultureInfo("fr-FR");


    // ====================== ÉCHÉANCIER – ÉTAT ======================
    private List<EcheancierItem> echeanciers = new();

    // Liste déroulante des mois (clé "yyyy-MM", libellé FR)
    private sealed record MonthOpt(int Year, int Month, string Label)
    {
        public string Key => $"{Year:D4}-{Month:D2}";
    }
    private List<MonthOpt> EcheancierMonthOptions = new();

    private void EnsureEcheancierMonthOptions()
    {
        if (EcheancierMonthOptions.Count > 0) return;

        var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-6);

        for (int i = 0; i < 36; i++)
        {
            var d = start.AddMonths(i);
            EcheancierMonthOptions.Add(new MonthOpt(d.Year, d.Month, d.ToString("MMM-yy", fr)));
        }
    }

    // Helpers de binding "clé mois" <-> (BillingYear, BillingMonth)
    private static string EchGetMonthKey(EcheancierItem r) => $"{r.BillingYear:D4}-{r.BillingMonth:D2}";
    private static void EchSetMonthKey(EcheancierItem r, string key)
    {
        if (string.IsNullOrWhiteSpace(key) || key.Length < 7) return;
        if (int.TryParse(key.AsSpan(0, 4), out var y) &&
            int.TryParse(key.AsSpan(5, 2), out var m))
        {
            r.BillingYear = y;
            r.BillingMonth = Math.Clamp(m, 1, 12);
        }
    }

