                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>




    }



@* --- Onglet 5 : Planning & Jalons --- *@
else if (activeTab == "planning")
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Planning & Jalons</span>
            <button class="btn btn-sm btn-primary" @onclick="() => SavePlanningAsync(currentYear)">
                Enregistrer
            </button>
        </div>

        @if (!string.IsNullOrEmpty(planningSaveInfo))
        {
            <div class="alert alert-info py-1 my-2">@planningSaveInfo</div>
        }

        <div class="card-body">

            @* ================== TABLEAU PLANNING (Profils) ================== *@
            @if (project?.Profils is null || project.Profils.Count == 0)
            {
                <div class="text-muted">Aucun profil — ajoutez des lignes dans l’onglet « Ressources & Charges ».</div>
            }
            else
            {
                // Variables/calculs (inchangés)
                var planYear = project.Profils.First().PlanningYear;

                var culture = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                string LabelMois(int month) =>
                    culture.DateTimeFormat.GetAbbreviatedMonthName(month) + "." + (planYear % 100).ToString("00");

                    decimal[] totalParMois = new decimal[12];   // <-- on garde: total des 12 mois de l’année visible
                    decimal totalChargeTousProfils = 0m;
                    decimal totalPlanifieTousProfilsToutesAnnees = 0m;

                    foreach (var r in project.Profils)
                    {
                        // Total mensuel de l’ANNÉE COURANTE (pour les 12 colonnes)
                        for (int m = 0; m < 12; m++)
                            totalParMois[m] += r.Months?[m] ?? 0m;

                        // Total charge globale (cible à répartir)
                        totalChargeTousProfils += r.ChargeJh ?? 0m;

                        // Total planifié TOUTES ANNÉES pour ce profil
                        var pid = r.DbRowId ?? 0;
                        if (pid > 0)
                        {
                            foreach (var kv in _jhAllYears)
                                if (kv.Key.profilId == pid)
                                    totalPlanifieTousProfilsToutesAnnees += kv.Value;
                        }
                    }

                    // Ecart global = planifié (toutes années) - charge totale
                    decimal totalEcartTousProfils = totalPlanifieTousProfilsToutesAnnees - totalChargeTousProfils;


                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            @* Barre nav année en bleu clair, sans <div> dans <thead> *@
                            <tr class="table-primary">
                                @* 3 colonnes fixes + 12 mois = 15 colonnes totales
                                   On découpe en 3 zones : gauche(5), centre(5), droite(5). *@
                                <th colspan="5" class="p-2 text-start">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ChangeYearAsync(-1)">
                                        ← Année précédente
                                    </button>
                                </th>
                                <th colspan="5" class="p-2 text-center fw-semibold">
                                    Planning @currentYear
                                </th>
                                <th colspan="5" class="p-2 text-end">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => ChangeYearAsync(1)">
                                        Année suivante →
                                    </button>
                                </th>
                            </tr>

                            @* Ligne de titres en bleu clair *@
                            <tr class="table-primary">
                                <th>Profil</th>
                                <th>Charge par profil</th>
                                <th>Écart</th>
                                @for (int month = 1; month <= 12; month++)
                                {
                                    var label = new DateTime(currentYear, month, 1)
                                        .ToString("MMM.yy", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
                                    <th class="text-end">@label</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var row in project!.Profils)
                            {
                                    var chargeProfil = row.ChargeJh ?? 0m;
                                    var pid = row.DbRowId ?? 0;

                                    // Planifié TOUTES ANNÉES pour ce profil
                                    decimal planifieToutesAnnees = 0m;
                                    if (pid > 0)
                                    {
                                        foreach (var kv in _jhAllYears)
                                            if (kv.Key.profilId == pid)
                                                planifieToutesAnnees += kv.Value;
                                    }

                                    // Ecart = planifié (toutes années) - charge cible
                                    var ecart = planifieToutesAnnees - chargeProfil;




                                <tr>
                                    <td>
                                        <input class="form-control-plaintext form-control-sm"
                                               value="@row.Profil"
                                               readonly
                                               tabindex="-1" />
                                    </td>
                                    <td class="text-end">@chargeProfil.ToString("N2")</td>
                                    <td class="text-end @(ecart == 0 ? "" : (ecart > 0 ? "text-success" : "text-danger"))">
                                        @ecart.ToString("N2")
                                    </td>

                                    @for (int m = 0; m < 12; m++)
                                    {
                                        var mm = m;
                                        <td class="text-end">
                                                <InputNumber TValue="decimal?"
                                                             class="form-control form-control-sm text-end"
                                                             Value="row.Months[mm]"
                                                             ValueChanged="@(v => OnMonthChanged(row, mm, v))"
                                                             ValueExpression="@(() => row.Months[mm])" />

                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                        <tfoot class="table-primary">
                            <tr class="fw-semibold">
                                <td>TOTAL JH</td>
                                <td class="text-end">@totalChargeTousProfils.ToString("N2")</td>
                                <td class="text-end">@totalEcartTousProfils.ToString("N2")</td>
                                @for (int m = 0; m < 12; m++)
                                {
                                    <td class="text-end">@totalParMois[m].ToString("N2")</td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @* ================== TABLEAU PHASES ================== *@
            @{
                // Année d’affichage (on prend celle de la 1ʳᵉ ligne ou l’année courante)
                var phasesYear = phasePlans.FirstOrDefault()?.Year ?? DateTime.UtcNow.Year;

                var culture2 = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                string LabelMois2(int month) =>
                    culture2.DateTimeFormat.GetAbbreviatedMonthName(month) + "." + (phasesYear % 100).ToString("00");

                // Totaux (par mois / global)
                var totalParMoisPhases = new decimal[12];
                decimal totalChargePhases = 0m;
                decimal totalSaisieMoisPhases = 0m;

                foreach (var p in phasePlans)
                {
                    for (int m = 0; m < 12; m++)
                        totalParMoisPhases[m] += p.Months?[m] ?? 0m;

                    totalChargePhases += p.ChargeJh ?? 0m;
                    totalSaisieMoisPhases += (p.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                }
                var totalEcartPhases = totalSaisieMoisPhases - totalChargePhases;
            }

            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th style="min-width:220px">Phases</th>
                            <th class="text-end" style="width:120px">Charge par phase</th>
                            <th class="text-end" style="width:110px">Écart&nbsp;?</th>
                            @for (int m = 0; m < 12; m++)
                            {
                                <th class="text-end">@LabelMois2(m + 1)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in phasePlans)
                        {
                            var sommeMois = (p.Months ?? Array.Empty<decimal?>()).Sum(v => v ?? 0m);
                            var charge = p.ChargeJh ?? 0m;
                            var ecart = sommeMois - charge;

                            <tr>
                                <td class="align-middle">@Label(p.Phase)</td>
                                <td class="text-end" style="width:120px">
                                    <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                 @bind-Value="p.ChargeJh" />
                                </td>
                                <td class="text-end @(ecart == 0 ? "" : (ecart > 0 ? "text-success" : "text-danger"))">
                                    @ecart.ToString("N2")
                                </td>
                                @for (int m = 0; m < 12; m++)
                                {
                                    var mm = m;
                                    <td class="text-end">
                                        <InputNumber TValue="decimal?" class="form-control form-control-sm text-end"
                                                     @bind-Value="p.Months[mm]" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-primary">
                        <tr class="fw-semibold">
                            <td>TOTAL JH</td>
                            <td class="text-end">@totalChargePhases.ToString("N2")</td>
                            <td class="text-end @(totalEcartPhases == 0 ? "" : (totalEcartPhases > 0 ? "text-success" : "text-danger"))">
                                @totalEcartPhases.ToString("N2")
                            </td>
                            @for (int m = 0; m < 12; m++)
                            {
                                <td class="text-end">@totalParMoisPhases[m].ToString("N2")</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

                @* ================== ÉCHÉANCIER + VISION FAE côte à côte ================== *@
                <div class="row g-3 mt-3">

                    <!-- Col 1 : ÉCHÉANCIER -->
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100 equal-card equal-rows ">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Échéancier</span>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="EchAddRow">Ajouter un jalon</button>
                                    <button class="btn btn-sm btn-primary" @onclick="EchSaveAsync">Enregistrer</button>
                                </div>
                            </div>

                            <div class="card-body p-0">
                                @{
                                    // Calculs de haut de tableau
                                    var contrat = project?.ContractAmount ?? 0m;

                                    // lignes triées
                                    var rows = (echeanciers ?? new())
                                    .OrderBy(x => x.BillingYear)
                                    .ThenBy(x => x.BillingMonth)
                                    .ThenBy(x => x.Id)
                                    .ToList();

                                    // total % et total montant (normalisation 40 -> 0,40)
                                    decimal totalPercent = 0m;
                                    decimal totalMontant = 0m;
                                    foreach (var rr in rows)
                                    {
                                        var p = rr.Percent > 1m ? rr.Percent / 100m : rr.Percent;
                                        totalPercent += p;
                                        totalMontant += p * contrat;
                                    }
                                }

                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0 equal-table equal-rows ">
                                        <thead class="table-light thead-eche">
                                            <tr>
                                                <th style="width:70px">N°</th>
                                                <th>Nom échéance</th>
                                                <th class="text-end" style="width:120px">%</th>
                                                <th style="min-width:160px">Mois facturation</th>
                                                <th class="text-end" style="width:180px">Montant à facturation</th>
                                                <th style="width:48px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (rows.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-3">
                                                        Aucun jalon — cliquez « Ajouter un jalon ».
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                var index = 0;
                                                foreach (var row in rows)
                                                {
                                                    index++;

                                                    // normalisation : 40 -> 0,40
                                                    var percentNorm = row.Percent > 1m ? row.Percent / 100m : row.Percent;
                                                    var montantRow = percentNorm * contrat;

                                                    <tr>
                                                        <td class="text-end">@index</td>
                                                        <td>
                                                            <InputText class="form-control form-control-sm" @bind-Value="row.Label" />
                                                        </td>
                                                        <td>
                                                            <InputNumber TValue="decimal" class="form-control form-control-sm text-end"
                                                                         Value="@(row.Percent * 100m)"
                                                                         ValueChanged="@( (decimal v) => row.Percent = v/100m )"
                                                                         ValueExpression="@(()=>row.Percent)" />
                                                        </td>
                                                        <td>
                                                            <select class="form-select form-select-sm"
                                                                    value="@EchGetMonthKey(row)"
                                                                    @onchange="e => EchSetMonthKey(row, e.Value?.ToString() ?? string.Empty)">
                                                                @foreach (var m in EcheancierMonthOptions)
                                                                {
                                                                    <option value="@m.Key">@m.Label</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td class="text-end">@montantRow.ToString("N2")</td>
                                                        <td class="text-end">
                                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EchDeleteAsync(row)">❌</button>
                                                        </td>


                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr class="fw-semibold">
                                                <td></td>
                                                <td class="text-end">TOTAL</td>
                                                <td class="text-end">@((totalPercent * 100m).ToString("N2")) %</td>
                                                <td></td>
                                                <td class="text-end">@totalMontant.ToString("N2")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Col 2 : VISION FAE -->
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100 equal-card equal-rows">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>Vision FAE</span>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary invisible" type="button">.</button>
                                    <button class="btn btn-sm btn-primary invisible" type="button">.</button>
                                </div>
                            </div>
                            <div class="card-body p-0">


                        @{
                                    var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
                                    var contract = project?.ContractAmount ?? 0m;

                                    // Dictionnaire (year,month) -> coût engagé cumulé (dérivé du Planning)
                                    var coutCum = FaeBuildCoutEngageCumul();

                                    // Jalons triés
                                    var jalons = (echeanciers ?? new())
                                    .OrderBy(j => j.BillingYear)
                                    .ThenBy(j => j.BillingMonth)
                                    .ThenBy(j => j.Id)
                                    .ToList();

                                    decimal factureCum = 0m;
                                    decimal lastCout = 0m, lastFact = 0m, lastFae = 0m;
                                }

                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0 equal-table fae-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-end">Coût engagé<br />cumulé</th>
                                                <th class="text-end">Montant facturé<br />cumulé</th>
                                                <th class="text-end">Montant FAE (€)</th>
                                                <th class="text-end">Montant FAE (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (jalons.Count == 0)
                                            {
                                                <tr><td colspan="4" class="text-center text-muted py-3">Aucun jalon.</td></tr>
                                            }
                                            else
                                            {
                                                foreach (var j in jalons)
                                                {
                                                    

                           
                                                    // % stocké en fraction (0,40). Protection si anciens en "40"
                                                    var p = j.Percent > 1m ? j.Percent / 100m : j.Percent;

                                                    // Cumul facturé avance au jalon
                                                    factureCum += p * contract;

                                                    // Coût engagé cumulé à la fin du mois du jalon (ou dernier mois <=)
                                                    var ceCumul = GetCoutCumuleA(coutCum, j.BillingYear, j.BillingMonth);

                                                    // FAE
                                                    var fae = ceCumul - factureCum;
                                                    var faePct = contract > 0 ? (fae / contract) : (decimal?)null;

                                                    lastCout = ceCumul; lastFact = factureCum; lastFae = fae;

                                                    <tr>
                                                        <td class="text-end">@ceCumul.ToString("N2")</td>
                                                        <td class="text-end">@factureCum.ToString("N2")</td>
                                                        <td class="text-end">@fae.ToString("N2")</td>
                                                        <td class="text-end">@((faePct is null) ? "" : (faePct.Value * 100m).ToString("N2") + " %")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr class="fw-semibold">
                                                <td class="text-end">@lastCout.ToString("N2")</td>
                                                <td class="text-end">@lastFact.ToString("N2")</td>
                                                <td class="text-end">@lastFae.ToString("N2")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


            

        </div> @* /.card-body *@
    </div>     @* /.card shadow-sm *@
}              @* /else if (activeTab == "planning") *@




    
}
