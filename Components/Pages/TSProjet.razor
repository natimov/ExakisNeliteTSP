                                        <!-- Marges (readonly) -->
                                        <td><input class="form-control form-control-sm" value="@(row.MargeProfilExa is null ? "" : (row.MargeProfilExa.Value * 100m).ToString("N2") + " %")" readonly /></td>
                                        <td><input class="form-control form-control-sm" value="@(row.MargeProfilAgence is null ? "" : (row.MargeProfilAgence.Value * 100m).ToString("N2") + " %")" readonly /></td>

                                        <!-- Supprimer -->
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveProfilRow(row))">❌</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th>TOTAL</th>
                                <th></th>                 @* Entité *@
                                <th></th>                 @* TJM *@
                                <th></th>                 @* CJM *@
                                <th class="hide-md"></th> @* PRCS *@
                                <th class="hide-md"></th> @* Frais Déplacement *@
                                <th class="hide-md"></th> @* TCI/PRCS *@

                                <th class="num">@Num(totalCharge)</th>                  @* Charge (jh) *@
                                <th class="num">@Money(totalCA)</th>                    @* CA (€) *@
                                <th class="num hide-md">@Money(totalCoutExa)</th>       @* COUT Exakis Nelite (€) *@
                                <th class="num hide-md">@Money(totalCoutAgence)</th>    @* COUT AGENCE (€) *@

                                <th class="pct hide-md"></th>                           @* %jh PROFIL (pas de somme) *@
                                <th class="pct hide-md"></th>                           @* %€ PROFIL (pas de somme) *@

                                <th class="pct hide-md">@Pct(margeGlobaleExa)</th>      @* Marge globale Exa *@
                                <th class="pct hide-md">@Pct(margeGlobaleAgence)</th>   @* Marge globale Agence *@

                                <th></th>  @* colonne actions *@
