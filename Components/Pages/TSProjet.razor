    // VM lue par l’onglet Synthèse
    private SyntheseService.SyntheseVm? vm;

    // Construit/rafraîchit la synthèse à partir de l'état courant
    private void RebuildSynthese()
    {
        vm = SyntheseAdaptater.BuildVmFromDomain(
        project!,     // Project courant (déjà présent dans ta page)
        wlRows,       // tes WorkloadItem (la méthode de mapping ignore le détail pour l’instant)
        achatItem,    // List<AchatItem>
        frais,        // List<FraisItem>
        GetPlannedAllYears // TA méthode déjà présente: decimal GetPlannedAllYears(ProfilEntry r)
        );
        StateHasChanged();
    }


